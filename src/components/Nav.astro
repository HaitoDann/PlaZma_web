---
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';
import { site, socials } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hasContact = Boolean(site.email) || socials.length > 0;
const links = [
  { href: `${base}/#projet`, label: 'Le projet' },
  { href: `${base}/#roster`, label: 'Roster' },
  { href: `${base}/#palmares`, label: 'Palmarès' },
  { href: `${base}/actus`, label: 'Actus' },
  { href: `${base}/#recrutement`, label: 'Recrutement' },
  ...(hasContact ? [{ href: `${base}/#contact`, label: 'Contact' }] : []),
];
---
<header class="nav" id="nav">
  <div class="container nav__inner">
    <a href={`${base}/#top`} class="nav__brand" aria-label={`${site.name} — accueil`}>
      <Mark size={30} class="nav__logo" />
      <Wordmark class="nav__name" />
    </a>

    <nav class="nav__links" aria-label="Navigation principale">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <button class="nav__burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-menu">
      <Icon name="menu" size={22} />
    </button>
  </div>

  <div class="nav__mobile" id="mobile-menu" hidden>
    <nav aria-label="Navigation mobile">
      {links.map((l) => <a href={l.href} class="nav__mobile-link">{l.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(243, 241, 236, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav__inner { height: var(--nav-h); display: flex; align-items: center; gap: 24px; }
  .nav__brand { display: flex; align-items: center; gap: 10px; }
  .nav__logo { color: var(--violet); }
  .nav :global(.nav__name) { font-size: 1.15rem; }
  .nav__links { display: flex; gap: 6px; margin-left: auto; }
  .nav__links a {
    font-size: 0.92rem; font-weight: 600; color: var(--text);
    padding: 8px 14px; border-radius: 999px;
    transition: background .15s ease, color .15s ease;
  }
  .nav__links a:hover { background: var(--ink); color: var(--bg); }

  .nav__burger {
    display: none; margin-left: auto;
    background: transparent; border: 2px solid var(--ink); border-radius: 999px;
    color: var(--text); padding: 7px; cursor: pointer;
  }
  .nav__mobile { border-bottom: 1px solid var(--line); background: var(--bg); }
  .nav__mobile nav { display: flex; flex-direction: column; padding: 6px var(--gutter) 18px; }
  .nav__mobile-link {
    padding: 14px 2px;
    font-family: var(--font-display); font-weight: 800; font-stretch: 118%; text-transform: uppercase;
    font-size: 1.5rem; letter-spacing: -0.01em;
    border-bottom: 1px solid var(--line);
  }
  .nav__mobile-link:hover { color: var(--violet); }

  @media (max-width: 860px) {
    .nav__links { display: none; }
    .nav__burger { display: inline-flex; }
  }
</style>

<script>
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');
  if (burger && menu) {
    const toggle = (open: boolean) => {
      menu.hidden = !open;
      burger.setAttribute('aria-expanded', String(open));
    };
    burger.addEventListener('click', () => toggle(menu.hidden));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggle(false)));
  }
</script>
