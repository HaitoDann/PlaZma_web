---
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import { site, socials } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hasContact = Boolean(site.email) || socials.length > 0;
const links = [
  { href: `${base}/#roster`, label: 'Roster' },
  { href: `${base}/#palmares`, label: 'Palmarès' },
  { href: `${base}/actus`, label: 'Actus' },
  { href: `${base}/#recrutement`, label: 'Recrutement' },
  ...(hasContact ? [{ href: `${base}/#contact`, label: 'Contact' }] : []),
];
---
<header class="nav" id="nav">
  <div class="container nav__inner">
    <a href={`${base}/#top`} class="nav__brand" aria-label={`${site.name} — accueil`}>
      <Mark size={34} class="nav__logo" />
      <span class="nav__name">{site.name}</span>
    </a>

    <nav class="nav__links" aria-label="Navigation principale">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <button class="nav__burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-menu">
      <Icon name="menu" size={22} />
    </button>
  </div>

  <div class="nav__mobile" id="mobile-menu" hidden>
    <nav aria-label="Navigation mobile">
      {links.map((l) => <a href={l.href} class="nav__mobile-link">{l.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(7, 7, 10, 0.86);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .nav__inner { height: var(--nav-h); display: flex; align-items: center; gap: 24px; }
  .nav__brand { display: flex; align-items: center; gap: 11px; }
  .nav__logo { color: var(--violet); }
  .nav__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.45rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .nav__links { display: flex; gap: 28px; margin-left: auto; }
  .nav__links a {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
    padding: 6px 0;
    position: relative;
  }
  .nav__links a::after {
    content: ''; position: absolute; left: 0; bottom: 0;
    width: 0; height: 2px; background: var(--violet);
    transition: width 0.18s ease;
  }
  .nav__links a:hover { color: var(--text); }
  .nav__links a:hover::after { width: 100%; }

  .nav__burger {
    display: none; margin-left: auto;
    background: var(--surface); border: 1px solid var(--line);
    color: var(--text); padding: 8px; cursor: pointer;
  }
  .nav__mobile { border-bottom: 1px solid var(--line); background: var(--bg-2); }
  .nav__mobile nav { display: flex; flex-direction: column; padding: 6px var(--gutter) 18px; }
  .nav__mobile-link {
    padding: 15px 2px;
    font-weight: 500;
    font-size: 1rem;
    color: var(--text-2);
    border-bottom: 1px solid var(--line-soft);
  }
  .nav__mobile-link:hover { color: var(--text); }

  @media (max-width: 860px) {
    .nav__links { display: none; }
    .nav__burger { display: inline-flex; }
  }
</style>

<script>
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');
  if (burger && menu) {
    const toggle = (open: boolean) => {
      menu.hidden = !open;
      burger.setAttribute('aria-expanded', String(open));
    };
    burger.addEventListener('click', () => toggle(menu.hidden));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggle(false)));
  }
</script>
