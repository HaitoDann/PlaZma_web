---
/* Histoire du club : frise verticale. Une ligne violette se remplit au
   scroll et allume les jalons (losanges biseautés) au fur et à mesure. */
import { story, storyGoal } from '../data/content';

const events = [...story].sort((a, b) => a.date.localeCompare(b.date));
const years = [...new Set(events.map((e) => e.date.slice(0, 4)))];
---
<div class="tl" data-timeline>
  <div class="tl__rail" aria-hidden="true"><div class="tl__fill"></div></div>
  {years.map((y) => (
    <section class="tl__year">
      <h3 class="tl__y num">{y}</h3>
      <ol class="tl__list">
        {events.filter((e) => e.date.startsWith(y)).map((e) => (
          <li class:list={['tl__item', { 'is-title': e.type === 'titre', 'is-upcoming': e.upcoming }]} data-reveal>
            <h4 class="tl__title">{e.title}</h4>
            <p class="tl__text">{e.text}</p>
          </li>
        ))}
      </ol>
    </section>
  ))}
  <p class="tl__goal tl__item" data-reveal>
    <span>Objectif</span>
    {storyGoal.title}
  </p>
</div>

<script>
  for (const tl of document.querySelectorAll<HTMLElement>('[data-timeline]')) {
    const items = [...tl.querySelectorAll<HTMLElement>('.tl__item')];
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = tl.getBoundingClientRect();
      const line = innerHeight * 0.6;               // point de lecture : 60 % de l'écran
      const filled = Math.max(0, Math.min(r.height, line - r.top));
      tl.style.setProperty('--fill', `${filled}px`);
      for (const it of items) {
        it.classList.toggle('is-lit', it.getBoundingClientRect().top - r.top + 14 <= filled);
      }
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();
  }
</script>

<style>
  .tl { --rail-x: 5px; --fill: 0px; position: relative; padding-left: 40px; }
  .tl__rail { position: absolute; left: var(--rail-x); top: 0; bottom: 0; width: 2px; background: var(--line); }
  .tl__fill { width: 100%; height: var(--fill); background: var(--violet); transition: height .12s linear; }

  .tl__year {
    display: grid; grid-template-columns: minmax(120px, 260px) 1fr; gap: 0 clamp(24px, 5vw, 72px);
    border-top: 1px solid var(--line); padding-block: clamp(28px, 4vw, 44px);
  }
  .tl__y {
    font-family: var(--font-display); font-weight: 900; font-stretch: 125%; line-height: .8;
    font-size: clamp(3.2rem, 7vw, 6rem); letter-spacing: -0.04em;
    position: sticky; top: calc(var(--nav-h) + 24px); align-self: start;
    color: var(--line); transition: color .3s ease;
  }
  .tl__year:has(.is-lit) .tl__y { color: var(--ink); }
  .tl__list { list-style: none; padding: 0; display: grid; gap: clamp(24px, 3vw, 36px); }

  /* Jalon : pastille carrée posée sur le rail */
  .tl__item::before {
    content: ''; position: absolute; left: calc(var(--rail-x) - 5px); margin-top: 6px;
    width: 12px; height: 12px; background: var(--bg); border: 2px solid var(--line);
    transition: background .3s ease, border-color .3s ease;
  }
  .tl__item.is-lit::before { background: var(--violet); border-color: var(--violet); }
  .tl__item.is-title.is-lit::before { background: var(--ink); border-color: var(--ink); }

  /* Fondu seul : un transform ferait des items le repère des jalons. */
  :global(.js) .tl__item[data-reveal] { transform: none; }

  .tl__title {
    font-family: var(--font-display); font-weight: 800; font-stretch: 112%; text-transform: uppercase;
    font-size: clamp(1.3rem, 2.2vw, 1.75rem); line-height: 1.02; margin-bottom: 8px; letter-spacing: -0.01em;
    transition: color .3s ease;
  }
  .tl__item:not(.is-lit) .tl__title { color: var(--text-3); }
  .tl__text { max-width: 60ch; }
  .tl__item.is-title.is-lit .tl__title { color: var(--violet); }
  .tl__item.is-upcoming .tl__title::after {
    content: 'À venir'; margin-left: 10px; vertical-align: middle;
    font: 600 0.7rem var(--font); letter-spacing: 0.08em; text-transform: uppercase;
    padding: 4px 8px; border-radius: 999px; border: 1.5px solid currentColor;
  }

  .tl__goal {
    border-top: 2px solid var(--ink); padding-top: clamp(24px, 3vw, 36px);
    font-family: var(--font-display); font-weight: 900; font-stretch: 125%; text-transform: uppercase;
    font-size: clamp(2.6rem, 8vw, 6.5rem); line-height: .85; letter-spacing: -0.03em; color: var(--violet);
  }
  .tl__goal span {
    display: block; font-family: var(--font); font-weight: 600; font-stretch: 100%; text-transform: uppercase;
    font-size: 0.8rem; letter-spacing: 0.08em; color: var(--text-3); margin-bottom: 14px;
  }

  @media (max-width: 760px) {
    .tl { padding-left: 30px; }
    .tl__year { grid-template-columns: 1fr; gap: 18px; }
    .tl__y { position: static; color: var(--ink); }
  }
</style>
