---
/* Histoire du club, en format éditorial : une colonne date, une colonne
   récit, séparées par de simples filets. Pas de cartes ni de pictos. */
import { story, storyGoal } from '../data/content';

const events = [...story].sort((a, b) => a.date.localeCompare(b.date));
const years = [...new Set(events.map((e) => e.date.slice(0, 4)))];
---
<div class="tl">
  {years.map((y) => (
    <section class="tl__year">
      <h3 class="tl__y num">{y}</h3>
      <ol class="tl__list">
        {events.filter((e) => e.date.startsWith(y)).map((e) => (
          <li class:list={['tl__item', { 'is-title': e.type === 'titre', 'is-upcoming': e.upcoming }]}>
            <time class="tl__when" datetime={e.date}>{e.when}</time>
            <div>
              <h4 class="tl__title">{e.title}</h4>
              <p class="tl__text">{e.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
  <p class="tl__goal">
    <span>Objectif</span>
    {storyGoal.title}
  </p>
</div>

<style>
  .tl__year {
    display: grid; grid-template-columns: minmax(120px, 220px) 1fr; gap: 0 clamp(24px, 5vw, 72px);
    border-top: 1px solid var(--line); padding-block: clamp(28px, 4vw, 44px);
  }
  .tl__y {
    font-family: var(--font-display); font-weight: 800; line-height: .8;
    font-size: clamp(3.4rem, 8vw, 6.5rem); color: var(--violet-soft); letter-spacing: -0.01em;
    position: sticky; top: calc(var(--nav-h) + 24px); align-self: start;
  }
  .tl__list { list-style: none; padding: 0; display: grid; gap: clamp(26px, 3.5vw, 38px); }
  .tl__item { display: grid; grid-template-columns: 130px 1fr; gap: 20px; }
  .tl__when { font-size: 0.85rem; color: var(--text-3); padding-top: 4px; }
  .tl__title {
    font-family: var(--font-display); font-weight: 700; text-transform: uppercase;
    font-size: clamp(1.35rem, 2.2vw, 1.7rem); line-height: 1.05; margin-bottom: 8px;
  }
  .tl__text { max-width: 62ch; }
  .tl__item.is-title .tl__title { color: var(--gold); }
  .tl__item.is-upcoming .tl__title { color: var(--violet-soft); }

  .tl__goal {
    border-top: 1px solid var(--line); padding-top: clamp(36px, 5vw, 56px);
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    font-size: clamp(2.6rem, 7vw, 5.5rem); line-height: .9;
    background: linear-gradient(90deg, #fff 0%, var(--violet-soft) 60%, var(--violet-bright)); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .tl__goal span {
    display: block; font-family: var(--font); font-weight: 500; text-transform: none;
    font-size: 0.95rem; color: var(--text-3); margin-bottom: 14px;
  }

  @media (max-width: 760px) {
    .tl__year { grid-template-columns: 1fr; gap: 18px; }
    .tl__y { position: static; }
    .tl__item { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
