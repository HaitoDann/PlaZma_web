---
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';
import { site, socials } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
const cols = [
  { title: 'Le club', links: [
    { href: `${base}/club`, label: 'Notre histoire' },
    { href: `${base}/recrutement`, label: 'Recrutement' },
  ] },
  { title: 'Compétition', links: [
    { href: `${base}/roster`, label: 'Roster' },
    { href: `${base}/palmares`, label: 'Palmarès' },
    { href: `${base}/actus`, label: 'Actus' },
  ] },
];
---
<footer class="footer">
  <div class="container footer__top">
    <a href={`${base}/#top`} class="footer__brand" aria-label={`${site.name} — accueil`}>
      <Mark size={34} class="footer__mark" />
      <Wordmark />
    </a>

    <nav class="footer__nav" aria-label="Pied de page">
      {cols.map((c) => (
        <div class="footer__col">
          <p class="footer__h">{c.title}</p>
          {c.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      ))}
    </nav>

    {socials.length > 0 && (
      <div class="footer__socials" aria-label="Réseaux sociaux">
        {socials.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
            <Icon name={s.icon} size={19} />
          </a>
        ))}
      </div>
    )}
  </div>

  <div class="container footer__giant" aria-hidden="true"><Wordmark /></div>

  <div class="container footer__bottom">
    <span class="num">© {year} {site.name}</span>
    <span>Club esport · {site.game}</span>
    <span class="footer__fine">Non affilié à Riot Games.</span>
  </div>
</footer>

<style>
  .footer { background: var(--bg-2); border-top: 1px solid var(--line); margin-top: clamp(32px, 5vw, 64px); overflow: hidden; }
  .footer__top { display: flex; align-items: flex-start; gap: 40px; flex-wrap: wrap; padding-block: 48px 24px; }
  .footer__brand { display: flex; align-items: center; gap: 10px; font-size: 1.15rem; }
  .footer__mark { color: var(--violet-bright); }
  .footer__nav { display: flex; gap: clamp(32px, 6vw, 88px); flex-wrap: wrap; margin-left: auto; }
  .footer__col { display: grid; gap: 10px; align-content: start; }
  .footer__h { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text); margin-bottom: 4px; }
  .footer__col a { color: var(--text-2); font-size: 0.92rem; }
  .footer__col a:hover { color: var(--violet-ink); }
  .footer__socials { display: flex; gap: 14px; }
  .footer__socials a { color: var(--text-2); }
  .footer__socials a:hover { color: var(--text); }
  .footer__giant {
    font-size: clamp(4rem, 21.5vw, 17.5rem); line-height: .78; letter-spacing: -0.045em;
    padding-top: 8px; margin-bottom: -0.12em;
  }
  .footer__giant :global(.wm) { color: var(--surface-2); }
  .footer__bottom {
    position: relative; display: flex; gap: 20px; flex-wrap: wrap;
    padding-block: 20px; border-top: 1px solid var(--line); background: var(--bg-2);
    font-size: 0.82rem; color: var(--text-3);
  }
  .footer__fine { margin-left: auto; }
  @media (max-width: 640px) { .footer__nav { margin-left: 0; width: 100%; } }
</style>
