---
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';
import { site, socials } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
const links = [
  { href: `${base}/#roster`, label: 'Roster' },
  { href: `${base}/#palmares`, label: 'Palmarès' },
  { href: `${base}/actus`, label: 'Actualités' },
  { href: `${base}/#recrutement`, label: 'Recrutement' },
];
---
<footer class="footer">
  <div class="container footer__top">
    <a href={`${base}/#top`} class="footer__brand" aria-label={`${site.name} — accueil`}>
      <Mark size={34} class="footer__mark" />
      <Wordmark />
    </a>

    <nav class="footer__nav" aria-label="Pied de page">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    {socials.length > 0 && (
      <div class="footer__socials" aria-label="Réseaux sociaux">
        {socials.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
            <Icon name={s.icon} size={19} />
          </a>
        ))}
      </div>
    )}
  </div>

  <div class="container footer__giant" aria-hidden="true"><Wordmark /></div>

  <div class="container footer__bottom">
    <span class="num">© {year} {site.name}</span>
    <span>Club esport · {site.game}</span>
    <span class="footer__fine">Non affilié à Riot Games.</span>
  </div>
</footer>

<style>
  .footer { background: var(--ink); color: #fff; margin-top: clamp(32px, 5vw, 64px); }
  .footer__top {
    display: flex; align-items: center; gap: 28px; flex-wrap: wrap;
    padding-block: 40px 28px;
  }
  .footer__brand { display: flex; align-items: center; gap: 10px; font-size: 1.15rem; }
  .footer__brand :global(.wm) { color: #fff; }
  .footer__mark { color: #c9a6e6; }
  .footer__nav { display: flex; gap: 24px; flex-wrap: wrap; margin-left: auto; }
  .footer__nav a { color: #c8c4cd; font-weight: 500; }
  .footer__nav a:hover { color: #fff; }
  .footer__socials { display: flex; gap: 14px; }
  .footer__socials a { color: #c8c4cd; }
  .footer__socials a:hover { color: #fff; }
  .footer__giant {
    font-size: clamp(4rem, 21.5vw, 17.5rem); line-height: .78; letter-spacing: -0.045em;
    overflow: hidden; padding-top: 8px;
  }
  .footer__giant :global(.wm) { color: #1f1c24; }
  .footer__bottom {
    display: flex; gap: 20px; flex-wrap: wrap;
    padding-block: 20px; border-top: 1px solid #2a2730;
    font-size: 0.82rem; color: #8e8a94;
  }
  .footer__fine { margin-left: auto; }
  @media (max-width: 640px) {
    .footer__nav { margin-left: 0; width: 100%; }
  }
</style>
