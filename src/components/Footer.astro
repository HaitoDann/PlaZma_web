---
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import { site, socials } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
const links = [
  { href: `${base}/#roster`, label: 'Roster' },
  { href: `${base}/#palmares`, label: 'Palmarès' },
  { href: `${base}/#actus`, label: 'Actualités' },
  { href: `${base}/#recrutement`, label: 'Recrutement' },
];
---
<footer class="footer">
  <div class="container footer__top">
    <a href={`${base}/#top`} class="footer__brand" aria-label={`${site.name} — accueil`}>
      <Mark size={26} class="footer__mark" />
      <span>{site.name}</span>
    </a>

    <nav class="footer__nav" aria-label="Pied de page">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    {socials.length > 0 && (
      <div class="footer__socials" aria-label="Réseaux sociaux">
        {socials.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
            <Icon name={s.icon} size={19} />
          </a>
        ))}
      </div>
    )}
  </div>

  <div class="container footer__bottom">
    <span class="num">© {year} {site.name}</span>
    <span>Club esport · {site.game}</span>
    <span class="footer__fine">Non affilié à Riot Games.</span>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); background: var(--bg); margin-top: 20px; }
  .footer__top {
    display: flex; align-items: center; gap: 28px; flex-wrap: wrap;
    padding-block: 40px 28px;
  }
  .footer__brand {
    display: flex; align-items: center; gap: 11px;
    font-family: var(--font-display); font-weight: 800; font-size: 1.3rem;
  }
  .footer__mark { color: var(--violet); }
  .footer__nav { display: flex; gap: 24px; flex-wrap: wrap; margin-left: 8px; }
  .footer__nav a { color: var(--text-2); font-size: 0.92rem; }
  .footer__nav a:hover { color: var(--text); }
  .footer__socials { display: flex; gap: 14px; margin-left: auto; }
  .footer__socials a { color: var(--text-3); }
  .footer__socials a:hover { color: var(--text); }
  .footer__bottom {
    display: flex; gap: 20px; flex-wrap: wrap;
    padding-block: 20px; border-top: 1px solid var(--line-soft);
    font-size: 0.82rem; color: var(--text-3);
  }
  .footer__fine { margin-left: auto; }
  @media (max-width: 640px) {
    .footer__nav { margin-left: 0; width: 100%; }
    .footer__socials { margin-left: 0; }
  }
</style>
