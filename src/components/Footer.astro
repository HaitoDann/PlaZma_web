---
import Icon from './Icon.astro';
import { site, socials } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer__word" aria-hidden="true">{site.name}</div>

    <div class="footer__row">
      <p class="footer__desc">{site.intro}</p>
      {socials.length > 0 && (
        <div class="footer__socials" aria-label="Réseaux sociaux">
          {socials.map((s) => (
            <a href={s.url} class="footer__social" target="_blank" rel="noopener noreferrer" aria-label={s.name}>
              <Icon name={s.icon} size={18} />
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="footer__bottom">
      <span class="num">© {year} {site.name}</span>
      <span>{site.game}</span>
      <span class="footer__fineprint">Non affilié à Riot Games.</span>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line-strong); background: var(--bg-2); padding-top: clamp(44px, 6vw, 72px); }
  .footer__word {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(3.5rem, 18vw, 15rem);
    line-height: 0.82;
    letter-spacing: -0.03em;
    color: var(--surface-2);
    user-select: none;
  }
  .footer__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
    padding-block: 28px;
    border-top: 1px solid var(--line);
    margin-top: 10px;
  }
  .footer__desc { max-width: 46ch; color: var(--text-3); font-size: 0.92rem; }
  .footer__socials { display: flex; gap: 8px; }
  .footer__social {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px;
    background: var(--surface); color: var(--text-2);
    border: 1px solid var(--line);
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }
  .footer__social:hover { color: #fff; background: var(--violet); border-color: var(--violet); }
  .footer__bottom {
    display: flex; gap: 20px; flex-wrap: wrap;
    padding-block: 20px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .footer__fineprint { margin-left: auto; opacity: 0.8; }
</style>
