---
/* Icônes de champions : fichier local s'il existe, sinon CommunityDragon.
   Le nom en jeu est converti en identifiant : "Kai'Sa" → "kaisa". */
import { existsSync } from 'node:fs';

interface Props { names: string[]; }
const { names } = Astro.props;
const alias: Record<string, string> = { wukong: 'monkeyking', nunuwillump: 'nunu', renataglasc: 'renata' };
const key = (n: string) => {
  const k = n.toLowerCase().normalize('NFD').replace(/[^a-z]/g, '');
  return alias[k] ?? k;
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Icône locale (public/champions/<id>.webp) si fournie, sinon CommunityDragon.
const src = (n: string) => existsSync(`public/champions/${key(n)}.webp`)
  ? `${base}/champions/${key(n)}.webp`
  : `https://cdn.communitydragon.org/latest/champion/${key(n)}/square`;
---
<ul class="champs">
  {names.map((n) => (
    <li>
      <img src={src(n)} alt="" width="52" height="52" loading="lazy" />
      <span>{n}</span>
    </li>
  ))}
</ul>

<style>
  .champs { list-style: none; padding: 0; display: flex; gap: 14px; flex-wrap: wrap; }
  .champs li { display: grid; justify-items: center; gap: 6px; width: 64px; }
  .champs img { width: 52px; height: 52px; border-radius: var(--radius); background: var(--surface-2); }
  .champs span { font-size: 0.72rem; color: var(--text-2); text-align: center; line-height: 1.2; }
</style>
