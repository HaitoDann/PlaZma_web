---
/* Logotype « PlaZma » : le P et le Z, initiales du monogramme, ressortent
   en capitales ; police Archivo Black. */
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<span class:list={['wm', cls]} aria-label="PlaZma"><b>P</b>la<b>Z</b>ma</span>

<style>
  .wm {
    font-family: 'Archivo Black', var(--font-display); font-weight: 400; text-transform: none;
    letter-spacing: -0.01em; white-space: nowrap; color: var(--text);
  }
  .wm b { font-weight: 400; }
</style>
