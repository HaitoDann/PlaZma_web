---
/* Carte « collectible » (inspiration Solary) : portrait 3:4 sur le visuel
   PlaZma (public/img/card-bg.webp), bandeau d'identité en pied. */
import Flag from './Flag.astro';

interface Props {
  pseudo: string;
  sub: string;          // poste ou fonction
  realName?: string;
  country?: string;
  photo?: string;
  href?: string;
  index?: number;
  captain?: boolean;
}
const { pseudo, sub, realName, country, photo, href, index, captain } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const Tag = href ? 'a' : 'div';
---
<Tag class:list={['pcard', { 'is-link': href }]} href={href}>
  <div class="pcard__art">
    <img src={`${base}/img/card-bg.webp`} alt="" class="pcard__bg" loading="lazy" />
    {photo ? (
      <img src={`${base}/roster/${photo}`} alt={pseudo} loading="lazy" class="pcard__photo" />
    ) : (
      <svg class="pcard__ghost" viewBox="0 0 200 240" aria-hidden="true">
        <defs><linearGradient id="gh" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".2"/><stop offset="1" stop-color="#fff" stop-opacity=".04"/></linearGradient></defs>
        <circle cx="100" cy="86" r="38" fill="url(#gh)" />
        <path d="M24 240c4-56 36-88 76-88s72 32 76 88z" fill="url(#gh)" />
      </svg>
    )}
    <span class="pcard__sub">{sub}{captain && <em class="pcard__cap" title="Capitaine">C</em>}</span>
    {index !== undefined && <span class="pcard__idx num">{String(index).padStart(2, '0')}</span>}
  </div>
  <div class="pcard__id">
    <div>
      <span class="pcard__pseudo">{pseudo}</span>
      {realName && <span class="pcard__real">{realName}</span>}
    </div>
    {country && <Flag emoji={country} class="pcard__flag" />}
  </div>
</Tag>

<style>
  .pcard {
    display: flex; flex-direction: column;
    background: var(--surface); border: 1px solid var(--line);
    transition: transform .25s ease, border-color .25s ease;
  }
  .pcard.is-link:hover { transform: translateY(-4px); border-color: var(--violet); }
  .pcard__art {
    position: relative; aspect-ratio: 3 / 4; overflow: hidden;
    background: #0a0814;
  }
  .pcard__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease, filter .3s ease; }
  .pcard.is-link:hover .pcard__bg { transform: scale(1.05); filter: brightness(1.2); }
  .pcard__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .pcard__ghost { position: absolute; left: 12%; right: 12%; bottom: 0; width: 76%; }
  .pcard__sub {
    position: absolute; left: 12px; top: 12px;
    font-size: 0.66rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    color: #fff; background: var(--violet); padding: 5px 9px;
  }
  .pcard__cap { font-style: normal; margin-left: 7px; padding-left: 7px; border-left: 1px solid rgba(255,255,255,.4); }
  .pcard__idx {
    position: absolute; right: 12px; bottom: 8px;
    font-family: var(--font-display); font-weight: 800; font-size: 2.6rem; line-height: 1;
    color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,.4);
  }
  .pcard__id {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    padding: 12px 14px 13px; border-top: 2px solid var(--violet); background: linear-gradient(180deg, #16121d, var(--surface));
  }
  .pcard__pseudo {
    display: block; font-family: var(--font-display); font-weight: 700;
    font-size: 1.3rem; line-height: 1.05; letter-spacing: 0.03em; text-transform: uppercase;
  }
  .pcard__real { display: block; font-size: 0.8rem; font-style: italic; color: var(--text-3); margin-top: 2px; }
  .pcard :global(.pcard__flag) { width: 22px; height: auto; flex: none; }
</style>
