---
/* Carte joueur : portrait sur fond sombre (halo prune au survol),
   numéro de maillot, bandeau d'identité en pied. */
import Flag from './Flag.astro';

interface Props {
  pseudo: string;
  sub: string;          // poste ou fonction
  realName?: string;
  country?: string;
  photo?: string;
  href?: string;
  captain?: boolean;
  index?: number;       // numéro affiché en haut à gauche
}
const { pseudo, sub, realName, country, photo, href, captain, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const Tag = href ? 'a' : 'div';
---
<Tag class:list={['pcard', { 'is-link': href }]} href={href}>
  <div class="pcard__art">
    {index && <span class="pcard__num num">{String(index).padStart(2, '0')}</span>}
    {photo ? (
      <img src={`${base}/roster/${photo}`} alt={pseudo} loading="lazy" class="pcard__photo" />
    ) : (
      <svg class="pcard__ghost" viewBox="0 0 200 240" aria-hidden="true">
        <defs><linearGradient id="gh" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".1"/><stop offset="1" stop-color="#fff" stop-opacity=".02"/></linearGradient></defs>
        <circle cx="100" cy="86" r="38" fill="url(#gh)" />
        <path d="M24 240c4-56 36-88 76-88s72 32 76 88z" fill="url(#gh)" />
      </svg>
    )}
  </div>
  <div class="pcard__id">
    <div>
      <span class="pcard__pseudo">{pseudo}</span>
      <span class="pcard__sub">{sub}{captain && ' · Capitaine'}{realName && ` · ${realName}`}</span>
    </div>
    {country && <Flag emoji={country} class="pcard__flag" />}
  </div>
</Tag>

<style>
  .pcard {
    display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius); overflow: hidden; transition: border-color .3s ease, transform .5s var(--ease);
  }
  .pcard.is-link:hover { border-color: #3a3046; transform: translateY(-4px); }
  .pcard__art { position: relative; aspect-ratio: 3 / 4; overflow: hidden; background: var(--bg-2); }
  .pcard__art::before {
    content: ''; position: absolute; inset: 0; z-index: 0;
    background: radial-gradient(80% 60% at 50% 100%, rgba(169, 35, 214, .22), transparent 70%);
    opacity: .35; transition: opacity .5s var(--ease);
  }
  .pcard.is-link:hover .pcard__art::before { opacity: 1; }
  .pcard__art::after {
    content: ''; position: absolute; inset: auto 0 0 0; height: 30%; z-index: 2;
    background: linear-gradient(to top, var(--surface), transparent);
  }
  .pcard__num {
    position: absolute; top: 10px; left: 12px; z-index: 3;
    font-family: var(--font-display); font-weight: 900; font-stretch: 125%; font-size: 1.4rem; line-height: 1;
    color: var(--text-3); transition: color .3s ease;
  }
  .pcard.is-link:hover .pcard__num { color: var(--violet-ink); }
  .pcard__photo {
    position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 94%; z-index: 1;
    object-fit: cover; object-position: top center; filter: grayscale(.35);
    transition: transform .7s var(--ease), filter .5s ease;
  }
  .pcard.is-link:hover .pcard__photo { transform: scale(1.05); filter: none; }
  .pcard__ghost { position: absolute; left: 12%; right: 12%; bottom: 0; width: 76%; z-index: 1; }
  .pcard__id { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 14px 14px; }
  .pcard__pseudo {
    display: block; font-family: var(--font-display); font-weight: 800; font-stretch: 118%;
    font-size: 1.2rem; line-height: 1.05; letter-spacing: -0.01em; text-transform: uppercase;
  }
  .pcard__sub { display: block; font-size: 0.8rem; color: var(--text-3); margin-top: 3px; }
  .pcard :global(.pcard__flag) { width: 20px; height: auto; flex: none; }
</style>
