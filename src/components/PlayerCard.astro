---
/* Carte joueur : portrait sur aplat (gris papier, violet au survol),
   numéro de maillot, bandeau d'identité en pied. */
import Flag from './Flag.astro';

interface Props {
  pseudo: string;
  sub: string;          // poste ou fonction
  realName?: string;
  country?: string;
  photo?: string;
  href?: string;
  captain?: boolean;
  index?: number;       // numéro affiché en haut à gauche
}
const { pseudo, sub, realName, country, photo, href, captain, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const Tag = href ? 'a' : 'div';
---
<Tag class:list={['pcard', { 'is-link': href }]} href={href}>
  <div class="pcard__art">
    {index && <span class="pcard__num num">{String(index).padStart(2, '0')}</span>}
    {photo ? (
      <img src={`${base}/roster/${photo}`} alt={pseudo} loading="lazy" class="pcard__photo" />
    ) : (
      <svg class="pcard__ghost" viewBox="0 0 200 240" aria-hidden="true">
        <defs><linearGradient id="gh" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#121015" stop-opacity=".14"/><stop offset="1" stop-color="#121015" stop-opacity=".04"/></linearGradient></defs>
        <circle cx="100" cy="86" r="38" fill="url(#gh)" />
        <path d="M24 240c4-56 36-88 76-88s72 32 76 88z" fill="url(#gh)" />
      </svg>
    )}
  </div>
  <div class="pcard__id">
    <div>
      <span class="pcard__pseudo">{pseudo}</span>
      <span class="pcard__sub">{sub}{captain && ' · Capitaine'}{realName && ` · ${realName}`}</span>
    </div>
    {country && <Flag emoji={country} class="pcard__flag" />}
  </div>
</Tag>

<style>
  .pcard { display: flex; flex-direction: column; background: var(--surface); border-radius: var(--radius); overflow: hidden; }
  .pcard__art { position: relative; aspect-ratio: 3 / 4; overflow: hidden; background: var(--surface-2); transition: background .25s ease; }
  .pcard.is-link:hover .pcard__art { background: var(--violet); }
  .pcard__num {
    position: absolute; top: 10px; left: 12px; z-index: 2;
    font-family: var(--font-display); font-weight: 900; font-stretch: 125%; font-size: 1.6rem; line-height: 1;
    color: var(--ink); transition: color .25s ease;
  }
  .pcard.is-link:hover .pcard__num { color: #fff; }
  .pcard__photo {
    position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 92%; z-index: 1;
    object-fit: cover; object-position: top center; transition: transform .4s ease;
  }
  .pcard.is-link:hover .pcard__photo { transform: scale(1.04); }
  .pcard__ghost { position: absolute; left: 12%; right: 12%; bottom: 0; width: 76%; z-index: 1; }
  .pcard__id { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 14px 14px; }
  .pcard__pseudo {
    display: block; font-family: var(--font-display); font-weight: 800; font-stretch: 118%;
    font-size: 1.25rem; line-height: 1.05; letter-spacing: -0.01em; text-transform: uppercase;
  }
  .pcard__sub { display: block; font-size: 0.82rem; color: var(--text-3); margin-top: 3px; }
  .pcard :global(.pcard__flag) { width: 20px; height: auto; flex: none; }
</style>
