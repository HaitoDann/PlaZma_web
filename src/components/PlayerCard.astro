---
/* Carte « collectible » (inspiration Solary) : portrait 3:4 sur le visuel
   PlaZma (public/img/card-bg.webp), bandeau d'identité en pied. */
import Flag from './Flag.astro';

interface Props {
  pseudo: string;
  sub: string;          // poste ou fonction
  realName?: string;
  country?: string;
  photo?: string;
  href?: string;
  captain?: boolean;
}
const { pseudo, sub, realName, country, photo, href, captain } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const Tag = href ? 'a' : 'div';
---
<Tag class:list={['pcard', { 'is-link': href }]} href={href}>
  <div class="pcard__art">
    <img src={`${base}/img/card-bg.webp`} alt="" class="pcard__bg" loading="lazy" />
    {photo ? (
      <img src={`${base}/roster/${photo}`} alt={pseudo} loading="lazy" class="pcard__photo" />
    ) : (
      <svg class="pcard__ghost" viewBox="0 0 200 240" aria-hidden="true">
        <defs><linearGradient id="gh" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".2"/><stop offset="1" stop-color="#fff" stop-opacity=".04"/></linearGradient></defs>
        <circle cx="100" cy="86" r="38" fill="url(#gh)" />
        <path d="M24 240c4-56 36-88 76-88s72 32 76 88z" fill="url(#gh)" />
      </svg>
    )}
  </div>
  <div class="pcard__id">
    <div>
      <span class="pcard__pseudo">{pseudo}</span>
      <span class="pcard__sub">{sub}{captain && ' · Capitaine'}{realName && ` · ${realName}`}</span>
    </div>
    {country && <Flag emoji={country} class="pcard__flag" />}
  </div>
</Tag>

<style>
  .pcard {
    display: flex; flex-direction: column;
    background: var(--surface); border: 1px solid var(--line);
    transition: transform .3s ease, border-color .3s ease;
  }
  .pcard.is-link:hover { transform: translateY(-3px); border-color: #3b3346; }
  .pcard__art { position: relative; aspect-ratio: 3 / 4; overflow: hidden; background: var(--bg-2); }
  .pcard__bg {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    filter: saturate(.6) brightness(.68); transition: filter .4s ease;
  }
  .pcard.is-link:hover .pcard__bg { filter: saturate(.8) brightness(.82); }
  .pcard__art::after { z-index: 2;
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to top, rgba(10,10,14,.85) 0%, rgba(10,10,14,0) 30%);
  }
  .pcard__photo {
    position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 92%; z-index: 1;
    object-fit: cover; object-position: top center; transition: transform .4s ease;
  }
  .pcard.is-link:hover .pcard__photo { transform: scale(1.03); }
  .pcard__ghost { position: absolute; left: 12%; right: 12%; bottom: 0; width: 76%; z-index: 1; opacity: .8; }
  .pcard__id {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    padding: 13px 14px 14px; border-top: 1px solid var(--line);
  }
  .pcard.is-link:hover .pcard__id { border-top-color: var(--violet); }
  .pcard__pseudo {
    display: block; font-family: var(--font-display); font-weight: 700;
    font-size: 1.3rem; line-height: 1.05; letter-spacing: 0.03em; text-transform: uppercase;
  }
  .pcard__sub { display: block; font-size: 0.8rem; font-style: italic; color: var(--text-3); margin-top: 3px; }
  .pcard :global(.pcard__flag) { width: 20px; height: auto; flex: none; opacity: .9; }
</style>
