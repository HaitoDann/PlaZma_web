  'arrow-up-right': `<path ${stroke} d="M7 17 17 7M8 7h9v9"/>`,
  menu: `<path ${stroke} d="M4 7h16M4 12h16M4 17h16"/>`,
  close: `<path ${stroke} d="M6 6l12 12M18 6 6 18"/>`,
  trophy: `<path ${stroke} d="M7 4h10v4a5 5 0 0 1-10 0V4Z"/><path ${stroke} d="M7 6H4v1a4 4 0 0 0 4 4M17 6h3v1a4 4 0 0 1-4 4M9 17h6M10 17l.5-3h3l.5 3M8 21h8"/>`,
  users: `<path ${stroke} d="M16 20v-1a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v1"/><circle ${stroke} cx="9" cy="8" r="3.2"/><path ${stroke} d="M22 20v-1a4 4 0 0 0-3-3.8M16 5.2A3.2 3.2 0 0 1 16 11"/>`,
  newspaper: `<path ${stroke} d="M4 5h13v14a1 1 0 0 1-1 1H6a2 2 0 0 1-2-2V5Z"/><path ${stroke} d="M17 8h2a1 1 0 0 1 1 1v9a2 2 0 0 1-2 2M7 9h7M7 13h7M7 17h4"/>`,
  mail: `<rect ${stroke} x="3" y="5" width="18" height="14" rx="2"/><path ${stroke} d="m4 7 8 6 8-6"/>`,
  'chevron-down': `<path ${stroke} d="m6 9 6 6 6-6"/>`,
  sword: `<path ${stroke} d="M14.5 17.5 3 6V3h3l11.5 11.5M13 19l6-6M16 16l4 4M19 21l2-2"/>`,
  star: `<path ${stroke} d="m12 3 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9 6.8 19.2l1-5.8L3.5 9.2l5.9-.9L12 3Z"/>`,
  // --- Marque (plein) ---
  discord: `<path ${brand} d="M20.3 4.9A19 19 0 0 0 15.6 3.4a13.3 13.3 0 0 0-.6 1.3 17.6 17.6 0 0 0-5 0 13 13 0 0 0-.7-1.3A19 19 0 0 0 4.6 4.9 19.7 19.7 0 0 0 1.2 18a19.1 19.1 0 0 0 5.8 2.9 14.2 14.2 0 0 0 1.2-2 12.4 12.4 0 0 1-2-.9l.5-.4a13.7 13.7 0 0 0 11.6 0l.5.4a12.4 12.4 0 0 1-2 1 14 14 0 0 0 1.2 1.9A19 19 0 0 0 23.8 18 19.6 19.6 0 0 0 20.3 4.9ZM8.5 15.3c-1.1 0-2-1-2-2.3s.9-2.3 2-2.3 2 1 2 2.3-.9 2.3-2 2.3Zm7 0c-1.1 0-2-1-2-2.3s.9-2.3 2-2.3 2 1 2 2.3-.9 2.3-2 2.3Z"/>`,
  x: `<path ${brand} d="M17.5 3h3.2l-7 8 8.2 10.9h-6.4l-5-6.6-5.8 6.6H1.5l7.5-8.6L1.2 3h6.6l4.5 6 5.2-6Zm-1.1 16.9h1.8L7.7 4.8H5.8l10.6 15.1Z"/>`,
  instagram: `<rect ${stroke} x="3" y="3" width="18" height="18" rx="5"/><circle ${stroke} cx="12" cy="12" r="4"/><circle ${brand} cx="17.5" cy="6.5" r="1.1"/>`,
  twitch: `<path ${brand} d="M4 3 3 6v13h4v3h3l3-3h4l5-5V3H4Zm16 9-3 3h-4l-3 3v-3H6V5h14v7Z"/><path ${brand} d="M15 7h2v5h-2zM10 7h2v5h-2z"/>`,
  youtube: `<path ${brand} d="M22.5 7.2a3 3 0 0 0-2.1-2.1C18.6 4.6 12 4.6 12 4.6s-6.6 0-8.4.5A3 3 0 0 0 1.5 7.2 31 31 0 0 0 1 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.8.5 8.4.5 8.4.5s6.6 0 8.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 23 12a31 31 0 0 0-.5-4.8ZM10 15.3V8.7l5.5 3.3-5.5 3.3Z"/>`,
  tiktok: `<path ${brand} d="M16.5 3c.3 2.3 1.6 3.7 3.8 3.9v2.6c-1.3.1-2.5-.3-3.8-1v5.8a5.9 5.9 0 1 1-5.9-5.9c.3 0 .6 0 .9.1v2.7a3.2 3.2 0 1 0 2.3 3V3h2.7Z"/>`,
};

const svg = icons[name] ?? '';
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={cls}
  aria-hidden="true"
  set:html={svg}
/>
