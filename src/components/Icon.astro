---
/* Jeu d'icônes ligne (stroke 1.8, currentColor) + logos de marque.
   Pas d'emoji d'interface — SVG cohérents partout. */
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls = '' } = Astro.props;

const stroke = `fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"`;
const brand = `fill="currentColor"`;

const icons: Record<string, string> = {
  // --- UI (ligne) ---
