---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import PlayerCard from '../components/PlayerCard.astro';
import NewsCard from '../components/NewsCard.astro';
import { site, recruitment, socials } from '../data/site';
import { roster, staff, results, ROLE_ORDER } from '../data/content';
import { roleLabel } from '../data/roles';
import { getNews } from '../data/news';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hasContact = Boolean(site.email) || socials.length > 0;
const orderedRoster = [...roster].sort(
  (a, b) => ROLE_ORDER.indexOf(a.role) - ROLE_ORDER.indexOf(b.role)
);
const news = await getNews();
const lead = news.find((n) => n.data.featured) ?? news[0];
const side = news.filter((n) => n !== lead).slice(0, 2);

const yearOf = (season: string) => season.match(/\d{4}/)?.[0] ?? season;
const seasons = [...new Set(results.map((r) => yearOf(r.season)))];
---
<Base>
  <!-- ======================= HERO ======================= -->
  <section class="hero">
    <Mark size={900} class="hero__mark" title="" />
    <div class="container hero__inner">
      <p class="kicker">Club esport · {site.game}</p>
      <h1 class="hero__title">{site.name}</h1>
      <p class="hero__text">{site.intro}</p>
      <div class="hero__cta">
        <a href="#roster" class="btn btn--primary">Découvrir l’équipe</a>
        <a href={`${base}/actus`} class="btn btn--ghost">Actualités</a>
      </div>
    </div>
    <div class="container hero__strip">
      <span>France · EUW</span>
      <span>OUAT — Saison 23</span>
      <span class="num">{String(roster.length).padStart(2, '0')} joueurs</span>
    </div>
  </section>

  <!-- ======================= ROSTER ======================= -->
  <section class="section" id="roster">
    <div class="container">
      <div class="s-head" data-reveal>
        <p class="kicker">Saison 23</p>
        <h2>Équipe LoL</h2>
      </div>

      <p class="sub-label">Joueurs</p>
      <ul class="cards cards--players">
        {orderedRoster.map((p, i) => (
          <li data-reveal>
            <PlayerCard
              pseudo={p.pseudo} sub={p.role} realName={p.realName} country={p.country}
              photo={p.photo} href={`${base}/joueur/${p.slug}`} index={i + 1}
            />
          </li>
        ))}
      </ul>

      {staff.length > 0 && (
        <>
          <p class="sub-label staff-label">Staff</p>
          <ul class="cards cards--staff">
            {staff.map((s) => (
              <li data-reveal>
                <PlayerCard pseudo={s.pseudo} sub={s.role} realName={s.realName} country={s.country} photo={s.photo} />
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  </section>

  <!-- ======================= ACTUS ======================= -->
  {lead && (
    <section class="section actus-sec" id="actus">
      <div class="container">
        <div class="actus-head" data-reveal>
          <div>
            <p class="kicker">Actus d’équipe</p>
            <h2>Dans les coulisses</h2>
          </div>
          <a href={`${base}/actus`} class="textlink">Toutes les actus <Icon name="arrow" /></a>
        </div>
        <div class={`news-grid ${side.length ? '' : 'is-single'}`}>
          <div class="news-grid__lead" data-reveal><NewsCard entry={lead} size="lg" /></div>
          {side.map((n) => <div data-reveal><NewsCard entry={n} /></div>)}
        </div>
      </div>
    </section>
  )}

  <!-- ======================= PALMARÈS ======================= -->
  <section class="section" id="palmares">
    <div class="container">
      <div class="s-head" data-reveal>
        <p class="kicker">Historique</p>
        <h2>Palmarès</h2>
      </div>

      {seasons.length > 1 && (
        <div class="filters" role="group" aria-label="Filtrer par année">
          <button class="filter is-on" data-year="all">Voir tout</button>
          {seasons.map((y) => <button class="filter" data-year={y}>{y}</button>)}
        </div>
      )}

      <ul class="palm">
        {results.map((r) => (
          <li class={`palm__row ${r.title ? 'is-title' : ''}`} data-year={yearOf(r.season)}>
            <span class="palm__place">{r.title && <Icon name="trophy" size={16} />}{r.placement}</span>
            <span class="palm__info">
              <span class="palm__comp">{r.competition}{r.division && <em> · {r.division}</em>}</span>
              <span class="palm__season">{r.season}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ======================= RECRUTEMENT ======================= -->
  <section class="section recruit-sec" id="recrutement">
    <div class="container">
      <div class="recruit cut" data-reveal>
        <div>
          <p class="kicker">Rejoindre le club</p>
          <h2>Recrutement <span class={`recruit__status ${recruitment.open ? 'is-open' : ''}`}>{recruitment.open ? 'Ouvert' : 'Fermé'}</span></h2>
        </div>
        <div class="recruit__right">
          <p>{recruitment.open ? recruitment.intro : recruitment.closedIntro}</p>
          {recruitment.open && recruitment.roles.length > 0 && (
            <p class="recruit__roles">Postes recherchés : <strong>{recruitment.roles.join(', ')}</strong></p>
          )}
          {recruitment.open && recruitment.ctaUrl && (
            <a href={recruitment.ctaUrl} class="btn btn--primary" target="_blank" rel="noopener">
              <Icon name="discord" size={17} /> {recruitment.ctaLabel}
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  {hasContact && (
    <section class="section" id="contact">
      <div class="container contact">
        <div>
          <p class="kicker">Contact</p>
          <h2>Nous écrire</h2>
        </div>
        {site.email && (
          <a href={`mailto:${site.email}`} class="btn btn--primary">
            <Icon name="mail" size={17} /> {site.email}
          </a>
        )}
      </div>
    </section>
  )}
</Base>

<script>
  const rows = document.querySelectorAll<HTMLElement>('.palm__row');
  document.querySelectorAll<HTMLButtonElement>('.filter').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter').forEach((b) => b.classList.toggle('is-on', b === btn));
      const y = btn.dataset.year;
      rows.forEach((r) => (r.hidden = y !== 'all' && r.dataset.year !== y));
    });
  });
</script>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative; overflow: hidden;
    min-height: min(88vh, 820px); display: flex; flex-direction: column; justify-content: flex-end;
    border-bottom: 1px solid var(--line);
    background: radial-gradient(60% 70% at 78% 40%, rgba(169,35,214,.10), transparent 70%);
  }
  .hero :global(.hero__mark) {
    position: absolute; right: -8%; top: 50%; transform: translateY(-50%);
    width: min(70vw, 900px); height: auto; color: var(--violet); opacity: .12;
  }
  .hero__inner { position: relative; padding-bottom: clamp(48px, 7vw, 88px); }
  .hero__title { font-size: clamp(4.5rem, 16vw, 12rem); letter-spacing: 0.01em; margin: 14px 0 18px; line-height: .85; }
  .hero__text { font-size: clamp(1.02rem, 1.5vw, 1.2rem); max-width: 46ch; }
  .hero__cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
  .hero__strip {
    position: relative; display: flex; gap: 12px 40px; flex-wrap: wrap;
    padding-block: 16px; border-top: 1px solid var(--line);
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-3);
  }
  .hero__strip span::before { content: '•'; color: var(--violet); margin-right: 10px; }

  /* ---------- ROSTER ---------- */
  .cards { display: grid; gap: 14px; justify-content: center; }
  .cards--players { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .cards--staff { grid-template-columns: repeat(auto-fit, minmax(0, 220px)); }
  .staff-label { margin-top: clamp(48px, 6vw, 72px); }
  @media (max-width: 1000px) { .cards--players { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 620px) {
    .cards--players { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .cards--staff { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  }

  /* ---------- ACTUS ---------- */
  .actus-sec { background: var(--bg-2); border-block: 1px solid var(--line-soft); }
  .actus-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: 32px; }
  .actus-head h2 { margin-top: 12px; }
  .news-grid { display: grid; grid-template-columns: 1.6fr 1fr; grid-auto-rows: 1fr; gap: 14px; }
  .news-grid__lead { grid-row: span 2; }
  .news-grid > div, .news-grid :global(.ncard) { height: 100%; }
  .news-grid.is-single { grid-template-columns: 1fr; }
  .news-grid.is-single .news-grid__lead { grid-row: auto; }
  @media (max-width: 820px) {
    .news-grid { grid-template-columns: 1fr; }
    .news-grid__lead { grid-row: auto; }
  }

  /* ---------- PALMARÈS ---------- */
  .filters { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  .filter {
    font: 600 0.78rem var(--font); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--text-2); background: transparent; border: 1px solid var(--line);
    padding: 10px 16px; cursor: pointer;
  }
  .filter:hover { color: var(--text); }
  .filter.is-on { background: var(--surface-2); color: var(--text); border-color: var(--surface-2); }
  .palm { max-width: 900px; margin-inline: auto; display: grid; gap: 8px; }
  .palm__row { display: grid; grid-template-columns: 160px 1fr; background: var(--surface); border: 1px solid var(--line); }
  .palm__row[hidden] { display: none; }
  .palm__place {
    display: flex; align-items: center; justify-content: center; gap: 8px; padding: 18px 12px;
    font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; text-transform: uppercase;
    background: var(--surface-2); color: var(--text-2);
  }
  .palm__row.is-title .palm__place { background: linear-gradient(135deg, #3a2a0a, #5a4312); color: var(--gold); }
  .palm__info { display: flex; flex-direction: column; justify-content: center; padding: 14px 20px; }
  .palm__comp { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; text-transform: uppercase; letter-spacing: 0.02em; }
  .palm__comp em { font-style: normal; color: var(--text-3); }
  .palm__season { font-size: 0.85rem; color: var(--text-3); }
  @media (max-width: 560px) { .palm__row { grid-template-columns: 110px 1fr; } .palm__place { font-size: 1.05rem; } }

  /* ---------- RECRUTEMENT ---------- */
  .recruit {
    display: grid; grid-template-columns: 1fr 1fr; gap: 28px 64px; align-items: center;
    background: var(--surface); padding: clamp(28px, 5vw, 56px);
    border-left: 3px solid var(--violet);
  }
  .recruit h2 { margin-top: 12px; }
  .recruit__status {
    display: inline-block; vertical-align: middle; margin-left: 10px;
    font: 700 0.72rem var(--font); letter-spacing: 0.14em; color: var(--text-3);
    border: 1px solid var(--line); padding: 6px 10px;
  }
  .recruit__status.is-open { color: #7ee2a8; border-color: #2c5a3f; }
  .recruit__right { display: grid; gap: 18px; justify-items: start; }
  @media (max-width: 760px) { .recruit { grid-template-columns: 1fr; } }

  .contact { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .contact h2 { margin-top: 12px; }
</style>
