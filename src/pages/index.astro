---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PlayerCard from '../components/PlayerCard.astro';
import NewsCard from '../components/NewsCard.astro';
import Timeline from '../components/Timeline.astro';
import Wordmark from '../components/Wordmark.astro';
import Mark from '../components/Mark.astro';
import { site, recruitment, socials, nextMatch } from '../data/site';
import { roster, staff, results, ROLE_ORDER } from '../data/content';
import { getNews } from '../data/news';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const orderedRoster = [...roster].sort(
  (a, b) => ROLE_ORDER.indexOf(a.role) - ROLE_ORDER.indexOf(b.role)
);
const news = await getNews();
const lead = news.find((n) => n.data.featured) ?? news[0];
const side = news.filter((n) => n !== lead).slice(0, 2);

// Palmarès : ordre chronologique, regroupé par année.
const palm = [...results].sort((a, b) => a.date.localeCompare(b.date));
const palmYears = [...new Set(palm.map((r) => r.date.slice(0, 4)))];

// Mise en gras de l'objectif dans l'intro.
const GOAL = 'la Division 2 de la LFL';
const [introA, introB] = site.intro.includes(GOAL) ? site.intro.split(GOAL) : [site.intro, ''];

// Chiffres clés du palmarès (compteurs animés).
const titles = results.filter((r) => r.title).length;
const divisions = results.map((r) => Number(r.division?.match(/\d+/)?.[0])).filter(Boolean);
const bestDiv = divisions.length ? Math.min(...divisions) : 0;
const stats = [
  { value: results.length, label: 'Compétitions disputées' },
  { value: titles, label: titles > 1 ? 'Titres remportés' : 'Titre remporté', gold: true },
  ...(bestDiv ? [{ value: bestDiv, prefix: 'D', label: 'Meilleure division atteinte' }] : []),
];

const matchDate = nextMatch
  ? new Date(nextMatch.date).toLocaleString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' })
  : '';
---
<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true">
      <span class="hero__slab hero__slab--a"></span>
      <span class="hero__slab hero__slab--b"></span>
    </div>
    <div class="container hero__inner">
      <Mark class="hero__mark" size="100%" title="" />
      <h1 class="hero__title glitch" data-text={site.name}><Wordmark /></h1>
      <p class="hero__text">{introA}{introB !== '' && <strong>{GOAL}</strong>}{introB}</p>
      <div class="hero__cta">
        <a href="#projet" class="btn btn--primary">Notre histoire</a>
        <a href="#roster" class="btn btn--ghost">Voir l’équipe <Icon name="arrow" /></a>
      </div>
    </div>

    {nextMatch && (
      <div class="match">
        <div class="container match__inner">
          <span class="match__label">Prochain match</span>
          <span class="match__vs">PlaZma <em>vs</em> {nextMatch.opponent}</span>
          <span class="match__meta">{nextMatch.competition} · <time datetime={nextMatch.date}>{matchDate}</time></span>
          {nextMatch.stream && <a href={nextMatch.stream} target="_blank" rel="noopener" class="textlink">Regarder <Icon name="arrow-up-right" /></a>}
        </div>
      </div>
    )}
  </section>

  <!-- LE PROJET -->
  <section class="section" id="projet">
    <div class="container">
      <h2 class="title" data-reveal>De zéro à la Division 2 de LFL</h2>
      <Timeline />
    </div>
  </section>

  <!-- ÉQUIPE -->
  <section class="section team" id="roster">
    <div class="container">
      <h2 class="title" data-reveal>L’équipe</h2>

      <h3 class="group">Joueurs</h3>
      <ul class="cards">
        {orderedRoster.map((p) => (
          <li data-reveal>
            <PlayerCard
              pseudo={p.pseudo} sub={p.role} realName={p.realName} country={p.country}
              photo={p.photo} href={`${base}/joueur/${p.slug}`} captain={p.captain}
            />
          </li>
        ))}
      </ul>

      {staff.length > 0 && (
        <>
          <h3 class="group">Staff</h3>
          <ul class="cards">
            {staff.map((s) => (
              <li data-reveal>
                <PlayerCard pseudo={s.pseudo} sub={s.role} realName={s.realName} country={s.country} photo={s.photo} href={`${base}/joueur/${s.slug}`} />
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  </section>

  <!-- PALMARÈS -->
  <section class="section" id="palmares">
    <div class="container">
      <h2 class="title" data-reveal>Palmarès</h2>
      <ul class="stats">
        {stats.map((st) => (
          <li class:list={['stat', 'cut', { 'is-gold': st.gold }]} data-reveal>
            <span class="stat__value num">{st.prefix}<span data-count={st.value}>{st.value}</span></span>
            <span class="stat__label">{st.label}</span>
          </li>
        ))}
      </ul>
      {palmYears.map((y) => (
        <section class="palm__year" data-reveal>
          <h3 class="palm__y num">{y}</h3>
          <ol class="palm">
            {palm.filter((r) => r.date.startsWith(y)).map((r) => (
              <li class:list={['palm__row', { 'is-title': r.title }]}>
                <span class="palm__place">{r.placement}</span>
                <span class="palm__comp">{r.competition}{r.division && <span class="palm__div"> — {r.division}</span>}</span>
                <span class="palm__season">{r.season}</span>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </section>

  <!-- ACTUS -->
  {lead && (
    <section class="section actus" id="actus">
      <div class="container">
        <div class="actus__head">
          <h2 class="title">Actus</h2>
          <a href={`${base}/actus`} class="textlink">Toutes les actus <Icon name="arrow" /></a>
        </div>
        <div class:list={['news-grid', { 'is-single': !side.length }]}>
          <div class="news-grid__lead" data-reveal><NewsCard entry={lead} size="lg" /></div>
          {side.map((n) => <div data-reveal><NewsCard entry={n} /></div>)}
        </div>
      </div>
    </section>
  )}

  <!-- RECRUTEMENT -->
  <section class="section" id="recrutement">
    <div class="container recruit" data-reveal>
      <h2 class="title">Recrutement {recruitment.open ? 'ouvert' : 'fermé'}</h2>
      <div class="recruit__body">
        <p>{recruitment.open ? recruitment.intro : recruitment.closedIntro}</p>
        {recruitment.open && recruitment.roles.length > 0 && (
          <p>Postes recherchés : <strong>{recruitment.roles.join(', ')}</strong></p>
        )}
        {recruitment.open && recruitment.ctaUrl && (
          <a href={recruitment.ctaUrl} class="btn btn--primary" target="_blank" rel="noopener">
            <Icon name="discord" size={17} /> {recruitment.ctaLabel}
          </a>
        )}
      </div>
    </div>
  </section>

  {site.email && (
    <section class="section" id="contact">
      <div class="container">
        <h2 class="title">Contact</h2>
        <a href={`mailto:${site.email}`} class="mail">{site.email}</a>
      </div>
    </section>
  )}
</Base>

<style>
  /* Titres de section : alignés à gauche, sans surtitre. */
  .title { font-size: clamp(2.4rem, 5vw, 4rem); margin-bottom: clamp(28px, 4vw, 48px); }

  /* HERO */
  .hero {
    position: relative; overflow: hidden;
    min-height: min(86vh, 800px); display: flex; flex-direction: column; justify-content: center;
  }
  /* Fond en relief, 100 % CSS : anthracite éclairé par deux halos,
     trame fine à 45° (l'angle du monogramme) et deux grands pans
     biseautés en volume à droite. */
  .hero__bg {
    position: absolute; inset: 0; overflow: hidden;
    background:
      radial-gradient(55% 65% at 22% 45%, rgba(169, 35, 214, .13), transparent 70%),
      radial-gradient(45% 55% at 95% 0%, rgba(90, 60, 170, .12), transparent 70%),
      linear-gradient(160deg, #14121b 0%, #0c0b11 55%, var(--bg) 100%);
  }
  .hero__bg::before {
    content: ''; position: absolute; inset: 0;
    background: repeating-linear-gradient(135deg, rgba(255,255,255,.028) 0 1px, transparent 1px 34px);
    -webkit-mask-image: radial-gradient(80% 90% at 70% 40%, #000, transparent 75%);
            mask-image: radial-gradient(80% 90% at 70% 40%, #000, transparent 75%);
  }
  .hero__slab {
    position: absolute; top: -10%; bottom: -10%;
    clip-path: polygon(38% 0, 100% 0, 100% 100%, 0 100%);
  }
  .hero__slab--a {
    right: -4%; width: 46%;
    background: linear-gradient(105deg, #1b1824 0%, #121018 60%, #0d0c12 100%);
    box-shadow: inset 1px 0 0 rgba(255,255,255,.04);
  }
  .hero__slab--a::before {          /* arête éclairée du pan */
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(105deg, transparent 37.6%, rgba(201, 74, 232, .55) 38%, transparent 38.5%);
  }
  .hero__slab--b {
    right: -12%; width: 30%;
    background: linear-gradient(105deg, #221d2d 0%, #15121c 70%);
    opacity: .8;
  }
  .hero::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 30%; z-index: 1;
    background: linear-gradient(to top, var(--bg), transparent);
  }
  @media (max-width: 760px) { .hero__slab--a { width: 70%; right: -30%; } .hero__slab--b { display: none; } }
  .hero__inner { position: relative; z-index: 2; isolation: isolate; padding-block: clamp(64px, 9vw, 112px); }
  .hero__title { font-size: clamp(3.2rem, 11vw, 8.5rem); margin: 0 0 26px; line-height: .85; }
  .hero__text strong { font-weight: 700; color: #fff; }

  /* Monogramme en filigrane, à moitié caché derrière le texte */
  .hero__inner :global(.hero__mark) {
    position: absolute; z-index: -1; pointer-events: none;
    top: 50%; left: clamp(-40px, 2vw, 40px); width: min(760px, 90vw); height: auto;
    transform: translateY(-50%) rotate(-4deg);
    color: var(--violet-bright); opacity: .16;
    -webkit-mask-image: linear-gradient(100deg, #000 30%, transparent 85%);
            mask-image: linear-gradient(100deg, #000 30%, transparent 85%);
  }

  /* Effet glitch : deux copies décalées du titre, découpées en tranches */
  .glitch { position: relative; display: inline-block; }
  .glitch::before, .glitch::after {
    content: attr(data-text); position: absolute; inset: 0;
    font-family: 'Archivo Black', var(--font-display); font-weight: 400; text-transform: none;
    letter-spacing: -0.01em; white-space: nowrap; pointer-events: none;
  }
  .glitch::before { color: var(--violet-bright); animation: glitch-a 3.2s infinite steps(1); }
  .glitch::after { color: #3ce0ff; animation: glitch-b 3.2s infinite steps(1); mix-blend-mode: screen; }
  @keyframes glitch-a {
    0%, 86%, 100% { clip-path: inset(0 0 100% 0); transform: none; }
    88% { clip-path: inset(10% 0 62% 0); transform: translate(-6px, 0); }
    91% { clip-path: inset(55% 0 20% 0); transform: translate(5px, 0); }
    94% { clip-path: inset(30% 0 45% 0); transform: translate(-3px, 0); }
  }
  @keyframes glitch-b {
    0%, 87%, 100% { clip-path: inset(0 0 100% 0); transform: none; }
    89% { clip-path: inset(70% 0 8% 0); transform: translate(6px, 0); }
    92% { clip-path: inset(20% 0 60% 0); transform: translate(-5px, 0); }
    95% { clip-path: inset(45% 0 35% 0); transform: translate(3px, 0); }
  }
  @media (prefers-reduced-motion: reduce) { .glitch::before, .glitch::after { display: none; } }
  .hero__text { font-size: clamp(1rem, 1.4vw, 1.1rem); max-width: 54ch; color: #c4c4cc; }
  .hero__cta { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; margin-top: 32px; }

  .match { position: relative; z-index: 2; border-top: 1px solid var(--line); background: rgba(7,7,10,.7); }
  .match__inner { display: flex; align-items: baseline; gap: 10px 28px; flex-wrap: wrap; padding-block: 18px; }
  .match__label { font-size: 0.85rem; color: var(--violet-soft); font-weight: 600; }
  .match__vs { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; text-transform: uppercase; }
  .match__vs em { font-style: normal; color: var(--text-3); margin-inline: 6px; }
  .match__meta { color: var(--text-2); font-size: 0.92rem; }
  .match .textlink { margin-left: auto; }

  /* ÉQUIPE */
  .team { background: var(--bg-2); }
  .group { font-family: var(--font); font-size: 0.95rem; font-weight: 600; text-transform: none; color: var(--text-2); margin: 0 0 16px; }
  .cards { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
  .cards + .group { margin-top: clamp(40px, 5vw, 56px); }
  @media (max-width: 1000px) { .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } }

  /* PALMARÈS */
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-bottom: clamp(40px, 5vw, 64px); }
  .stat {
    display: grid; gap: 8px; padding: clamp(22px, 3vw, 32px);
    background: linear-gradient(135deg, var(--surface-2), var(--surface) 70%);
    border-left: 3px solid var(--violet);
  }
  .stat.is-gold { border-left-color: var(--gold); }
  .stat__value { font-family: var(--font-display); font-weight: 800; font-size: clamp(3.4rem, 7vw, 5.2rem); line-height: .85; color: var(--text); }
  .stat.is-gold .stat__value { color: var(--gold); }
  .stat__label { font-size: 0.85rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); }

  .palm__year {
    display: grid; grid-template-columns: minmax(120px, 220px) 1fr; gap: 0 clamp(24px, 5vw, 72px);
    border-top: 1px solid var(--line); padding-top: clamp(20px, 3vw, 32px); margin-bottom: clamp(20px, 3vw, 32px);
  }
  .palm__y { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.6rem, 6vw, 4.5rem); line-height: .85; color: var(--text); }
  .palm { list-style: none; padding: 0; }
  .palm__row:first-child { padding-top: 0; }
  .palm__row:last-child { border-bottom: 0; }
  @media (max-width: 760px) { .palm__year { grid-template-columns: 1fr; gap: 12px; } }
  .palm__row {
    display: grid; grid-template-columns: minmax(130px, 200px) 1fr auto; align-items: baseline; gap: 8px 32px;
    padding-block: clamp(18px, 2.4vw, 26px); border-bottom: 1px solid var(--line);
  }
  .palm__place {
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    font-size: clamp(1.8rem, 3.6vw, 2.8rem); line-height: 1; color: var(--text-2);
  }
  .palm__row.is-title .palm__place { color: var(--gold); }
  .palm__comp { font-size: 1.1rem; font-weight: 600; color: var(--text); }
  .palm__div { font-weight: 400; color: var(--text-2); }
  .palm__season { font-size: 0.9rem; color: var(--text-3); text-align: right; }
  @media (max-width: 640px) {
    .palm__row { grid-template-columns: 1fr; gap: 4px; }
    .palm__season { text-align: left; }
  }

  /* ACTUS */
  .actus__head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .news-grid { display: grid; grid-template-columns: 1.6fr 1fr; grid-auto-rows: 1fr; gap: 14px; }
  .news-grid__lead { grid-row: span 2; }
  .news-grid > div, .news-grid :global(.ncard) { height: 100%; }
  .news-grid.is-single { grid-template-columns: 1fr; }
  .news-grid.is-single .news-grid__lead { grid-row: auto; }
  @media (max-width: 820px) {
    .news-grid { grid-template-columns: 1fr; }
    .news-grid__lead { grid-row: auto; }
  }

  /* RECRUTEMENT */
  .recruit { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 64px; align-items: start; }
  .recruit .title { margin-bottom: 0; }
  .recruit__body { display: grid; gap: 18px; justify-items: start; padding-top: 10px; }
  @media (max-width: 760px) { .recruit { grid-template-columns: 1fr; } }

  .mail { font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 600; color: var(--text); border-bottom: 2px solid var(--violet); }
</style>
