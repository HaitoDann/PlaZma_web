---
/* Accueil compact (esprit Solary) : une, roster en bande, chiffres,
   dernières actus, recrutement. Le détail vit sur les pages dédiées. */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PlayerCard from '../components/PlayerCard.astro';
import NewsCard from '../components/NewsCard.astro';
import Wordmark from '../components/Wordmark.astro';
import Palmares from '../components/Palmares.astro';
import Recruit from '../components/Recruit.astro';
import { site, nextMatch } from '../data/site';
import { roster, ROLE_ORDER } from '../data/content';
import { getNews } from '../data/news';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const orderedRoster = [...roster].sort(
  (a, b) => ROLE_ORDER.indexOf(a.role) - ROLE_ORDER.indexOf(b.role)
);
const news = await getNews();
const lead = news.find((n) => n.data.featured) ?? news[0];
const side = news.filter((n) => n !== lead).slice(0, 2);

// Mise en gras de l'objectif dans l'intro.
const GOAL = 'la Division 2 de la LFL';
const [introA, introB] = site.intro.includes(GOAL) ? site.intro.split(GOAL) : [site.intro, ''];

const matchDate = nextMatch
  ? new Date(nextMatch.date).toLocaleString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' })
  : '';
---
<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="container">
      <div class="hero__bar">
        <span><span class="dot"></span> Club esport · {site.game}</span>
        <span>Fondé en 2018 · Association loi 1901</span>
      </div>
      <h1 class="hero__title"><Wordmark /></h1>
      <div class="hero__grid">
        <p class="hero__text">{introA}{introB !== '' && <strong>{GOAL}</strong>}{introB}</p>
        <div class="hero__cta">
          <a href={`${base}/roster`} class="btn btn--primary">Voir l’équipe <Icon name="arrow" /></a>
          <a href={`${base}/club`} class="btn btn--ghost">Notre histoire</a>
        </div>
      </div>
    </div>
  </section>

  {nextMatch && (
    <div class="container">
      <div class="match">
        <span class="match__label"><span class="dot"></span> Prochain match</span>
        <span class="match__vs">PlaZma <em>vs</em> {nextMatch.opponent}</span>
        <span class="match__meta">{nextMatch.competition} · <time datetime={nextMatch.date}>{matchDate}</time></span>
        {nextMatch.stream && <a href={nextMatch.stream} target="_blank" rel="noopener" class="textlink">Regarder <Icon name="arrow-up-right" /></a>}
      </div>
    </div>
  )}

  <!-- ROSTER -->
  <section class="section">
    <div class="container">
      <div class="head">
        <p class="s-index"><b>01</b><i>/</i>L’équipe</p>
        <a href={`${base}/roster`} class="textlink">Tout le roster <Icon name="arrow" /></a>
      </div>
      <ul class="cards">
        {orderedRoster.map((p, i) => (
          <li data-reveal style={`transition-delay:${i * 60}ms`}>
            <PlayerCard pseudo={p.pseudo} sub={p.role} country={p.country} index={i + 1}
              photo={p.photo} href={`${base}/joueur/${p.slug}`} captain={p.captain} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CHIFFRES -->
  <section class="section section--tight">
    <div class="container">
      <div class="head">
        <p class="s-index"><b>02</b><i>/</i>Palmarès</p>
        <a href={`${base}/palmares`} class="textlink">Tous les résultats <Icon name="arrow" /></a>
      </div>
      <Palmares compact />
    </div>
  </section>

  <!-- ACTUS -->
  {lead && (
    <section class="section section--tight">
      <div class="container">
        <div class="head">
          <p class="s-index"><b>03</b><i>/</i>Actus</p>
          <a href={`${base}/actus`} class="textlink">Toutes les actus <Icon name="arrow" /></a>
        </div>
        <div class:list={['news-grid', { 'is-single': !side.length }]}>
          <div class="news-grid__lead" data-reveal><NewsCard entry={lead} size="lg" /></div>
          {side.map((n) => <div data-reveal><NewsCard entry={n} /></div>)}
        </div>
      </div>
    </section>
  )}

  <section class="section section--tight">
    <div class="container"><Recruit /></div>
  </section>
</Base>

<style>
  .section--tight { padding-top: 0; }
  .head {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    border-top: 1px solid var(--line); padding-top: 14px; margin-bottom: clamp(20px, 3vw, 32px);
  }
  .head .s-index { border: 0; padding: 0; margin: 0; }
  .head .textlink { border: 0; padding: 0; font-size: 0.85rem; }

  /* HERO */
  .hero { position: relative; padding-top: clamp(20px, 3vw, 32px); padding-bottom: clamp(48px, 7vw, 96px); overflow: hidden; }
  .hero__glow {
    position: absolute; inset: -20% -10% auto auto; width: 70%; height: 120%; pointer-events: none;
    background: radial-gradient(closest-side, rgba(169, 35, 214, .16), transparent 70%);
  }
  .hero .container { position: relative; }
  .hero__bar {
    display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;
    border-top: 1px solid var(--line); padding-top: 12px;
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-2);
  }
  .hero__bar .dot { margin-right: 6px; vertical-align: middle; }
  .hero__title {
    font-size: clamp(4.2rem, 21.5vw, 17.5rem); line-height: .8; letter-spacing: -0.045em;
    margin: clamp(16px, 2.5vw, 28px) 0 clamp(28px, 4vw, 44px) -0.04em;
    text-transform: none;
    animation: rise 1s var(--ease) both;
  }
  .hero__title :global(.wm b) { color: var(--violet); }
  .hero__grid {
    display: grid; grid-template-columns: minmax(0, 1.4fr) auto; gap: 24px 48px; align-items: end;
    animation: rise 1s .15s var(--ease) both;
  }
  .hero__text { font-size: clamp(1.1rem, 1.7vw, 1.35rem); line-height: 1.45; color: var(--text); max-width: 46ch; }
  .hero__text strong { font-weight: 700; color: var(--violet-ink); }
  .hero__cta { display: flex; gap: 10px; flex-wrap: wrap; }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } }
  @media (max-width: 820px) { .hero__grid { grid-template-columns: 1fr; } }

  .match {
    display: flex; align-items: baseline; gap: 10px 28px; flex-wrap: wrap;
    border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: 18px 22px;
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .match__label { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--violet); }
  .match__vs { font-family: var(--font-display); font-weight: 800; font-stretch: 118%; font-size: 1.35rem; text-transform: uppercase; }
  .match__vs em { font-style: normal; color: var(--text-3); margin-inline: 6px; }
  .match__meta { color: var(--text-2); font-size: 0.92rem; }
  .match .textlink { margin-left: auto; }

  .cards { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
  @media (max-width: 1000px) { .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; } }

  .news-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 10px; }
  .news-grid__lead { grid-row: span 2; }
  .news-grid > div, .news-grid :global(.ncard) { height: 100%; }
  .news-grid.is-single { grid-template-columns: 1fr; }
  .news-grid.is-single .news-grid__lead { grid-row: auto; }
  @media (max-width: 820px) { .news-grid { grid-template-columns: 1fr; } .news-grid__lead { grid-row: auto; } }
</style>
