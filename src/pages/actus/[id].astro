---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PlayerCard from '../../components/PlayerCard.astro';
import { site } from '../../data/site';
import { roster } from '../../data/content';
import { getNews, fmtDate } from '../../data/news';

export async function getStaticPaths() {
  return (await getNews()).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const players = roster.filter((p) => d.players.includes(p.slug));
---
<Base title={`${d.title} · ${site.name}`} description={d.excerpt}>
  <article class="art">
    <header class="container art__head">
      <a href={`${base}/actus`} class="art__back"><Icon name="arrow" size={14} /> Actus</a>
      <p class="art__meta"><span class="tag">{d.tag}</span><time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time></p>
      <h1 class="art__title">{d.title}</h1>
      <p class="art__lede">{d.excerpt}</p>
    </header>

    {d.cover && (
      <div class="container"><img class="art__cover" src={`${base}/actus/${d.cover}`} alt="" /></div>
    )}

    <div class="container art__body prose"><Content /></div>

    {players.length > 0 && (
      <section class="container art__players">
        <h2 class="art__ptitle">Dans cet article</h2>
        <ul>
          {players.map((p) => (
            <li><PlayerCard pseudo={p.pseudo} sub={p.role} country={p.country} photo={p.photo} href={`${base}/joueur/${p.slug}`} /></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>

<style>
  .art { padding-block: clamp(32px, 5vw, 64px) clamp(64px, 8vw, 104px); }
  .art__head, .art__body { max-width: 820px; }
  .art__back {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-3);
  }
  .art__back :global(svg) { transform: rotate(180deg); }
  .art__back:hover { color: var(--text); }
  .art__meta { display: flex; gap: 14px; align-items: center; margin-top: 36px; font-size: 0.82rem; color: var(--text-3); }
  .art__title { font-size: clamp(2.4rem, 6vw, 4.4rem); margin: 14px 0 20px; }
  .art__lede { font-size: 1.15rem; color: var(--text); }
  .art__cover { width: 100%; max-height: 560px; object-fit: cover; margin-top: 40px; border: 1px solid var(--line); }
  .art__body { margin-top: 40px; padding-top: 32px; border-top: 1px solid var(--line); }
  .prose :global(p), .prose :global(ul), .prose :global(blockquote) { margin-bottom: 1.1em; }
  .prose :global(ul) { list-style: none; }
  .prose :global(li) { padding-left: 22px; position: relative; color: var(--text-2); margin-bottom: 6px; }
  .prose :global(li)::before { content: ''; position: absolute; left: 0; top: .7em; width: 10px; height: 2px; background: var(--violet); }
  .prose :global(h2) { font-size: 2rem; margin: 1.4em 0 .5em; }
  .prose :global(a) { color: var(--violet-soft); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(blockquote) { border-left: 2px solid var(--violet); padding-left: 18px; }
  .prose :global(img) { margin: 1.4em 0; border: 1px solid var(--line); }
  .art__players { margin-top: 56px; }
  .art__ptitle { font-size: 1.8rem; }
  .art__players ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; margin-top: 18px; max-width: 900px; }
</style>
