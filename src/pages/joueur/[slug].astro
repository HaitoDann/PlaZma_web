---
/* Fiche joueur (inspiration Mandatory) : identité à gauche, portrait
   détouré à droite, rail de vignettes pour passer d'un joueur à l'autre. */
import { existsSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Mark from '../../components/Mark.astro';
import Flag from '../../components/Flag.astro';
import Champions from '../../components/Champions.astro';
import NewsCard from '../../components/NewsCard.astro';
import { roster, staff, ROLE_ORDER, type Player } from '../../data/content';
import { roleLabel } from '../../data/roles';
import { site } from '../../data/site';
import { getNews } from '../../data/news';

export function getStaticPaths() {
  const ordered = [...roster].sort(
    (a, b) => ROLE_ORDER.indexOf(a.role) - ROLE_ORDER.indexOf(b.role)
  );
  // Joueurs puis staff : même fiche, même rail.
  const people: Person[] = [
    ...ordered.map((p) => ({ ...p, label: roleLabel[p.role], short: p.role, isPlayer: true })),
    ...staff.map((s) => ({ ...s, label: s.role, short: s.role.split(' · ')[0], isPlayer: false })),
  ];
  return people.map((p, i) => ({
    params: { slug: p.slug },
    props: { player: p, ordered: people, index: i },
  }));
}

type Person = Omit<Player, 'role'> & { label: string; short: string; isPlayer: boolean };
interface Props { player: Person; ordered: Person[]; index: number; }
const { player: p, ordered, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const socials = p.socials ?? {};
const socialList = ([
  ['tiktok', socials.tiktok], ['x', socials.x], ['instagram', socials.instagram],
  ['twitch', socials.twitch], ['youtube', socials.youtube],
] as const).filter(([, url]) => url);
const related = (await getNews()).filter((n) => n.data.players.includes(p.slug)).slice(0, 3);
// Icône de poste : public/img/roles/<poste>.webp (ex. mid.webp)
const roleIcon = (r: string) => existsSync(`public/img/roles/${r.toLowerCase()}.webp`) ? `${base}/img/roles/${r.toLowerCase()}.webp` : '';
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title={`${p.pseudo} · ${site.name}`} description={`${p.pseudo}, ${p.label} de ${site.name}.`}>
  <article class="pp">
    <div class="container pp__frame">
      <div class="pp__top">
        <a href={`${base}/#roster`} class="pp__back"><Icon name="arrow" size={14} /> Roster</a>
        <span class="num">{pad(index + 1)} / {pad(ordered.length)}</span>
      </div>

      <div class="pp__grid">
        <div class="pp__id">
          <p class="pp__role">
            {p.isPlayer && roleIcon(p.short) && <img src={roleIcon(p.short)} alt="" width="34" height="34" class="pp__roleicon" />}
            {p.label}{p.captain && ' · Capitaine'}
          </p>
          <div class="pp__name-row">
            <h1 class="pp__name">{p.pseudo}</h1>
          </div>
          {(p.realName || p.age || p.nationality) && (
            <p class="pp__real">
              {p.realName}{p.realName && (p.age || p.nationality) && ' · '}{p.age && `${p.age} ans`}{p.age && p.nationality && ' · '}{p.nationality && <span class="pp__nat">{p.country && <Flag emoji={p.country} />} {p.nationality}</span>}
            </p>
          )}
          {p.quote && <blockquote class="pp__quote">« {p.quote} »</blockquote>}
          {p.bio && <p class="pp__bio">{p.bio}</p>}
          {p.champions && p.champions.length > 0 && (
            <div class="pp__champs">
              <h2 class="pp__label">Champions favoris</h2>
              <Champions names={p.champions} />
            </div>
          )}

          {socialList.length > 0 && (
            <div class="pp__socials">
              {socialList.map(([icon, url]) => (
                <a href={url} target="_blank" rel="noopener" aria-label={icon}><Icon name={icon} size={17} /></a>
              ))}
            </div>
          )}

          {p.isPlayer && p.setup && p.setup.length > 0 && <div class="pp__setup">
            <div class="pp__setup-head"><span>Setup</span><span class="num">2026</span></div>
            <dl>
                {p.setup.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
              </dl>
          </div>}
        </div>

        <div class="pp__visual">
          <Mark size={600} class="pp__bgmark" title="" />
          {p.photo ? (
            <img src={`${base}/roster/${p.photo}`} alt={`${p.pseudo}, ${p.label} de ${site.name}`} class="pp__photo" />
          ) : (
            <span class="pp__ghost" aria-hidden="true">{p.pseudo}</span>
          )}
        </div>

        <nav class="pp__rail" aria-label="Autres joueurs">
          {ordered.map((o) => (
            <a href={`${base}/joueur/${o.slug}`} class:list={['pp__thumb', { 'is-on': o.slug === p.slug }]}
               aria-current={o.slug === p.slug ? 'page' : undefined} title={o.pseudo}>
              {o.photo ? <img src={`${base}/roster/${o.photo}`} alt="" /> : <span>{o.short}</span>}
            </a>
          ))}
        </nav>
      </div>

    </div>

    {related.length > 0 && (
      <section class="container pp__news">
        <h2 class="pp__news-title">Actus</h2>
        <div class="pp__news-grid">
          {related.map((n) => <NewsCard entry={n} />)}
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .pp__frame { padding-top: 22px; }
  .pp__top {
    display: flex; justify-content: space-between; gap: 16px;
    border-top: 2px solid var(--ink); padding-top: 12px;
    font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
  }
  .pp__back { display: inline-flex; align-items: center; gap: 8px; }
  .pp__back :global(svg) { transform: rotate(180deg); }
  .pp__back:hover { color: var(--violet); }

  .pp__grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 76px;
    gap: clamp(20px, 4vw, 48px); align-items: center;
    min-height: min(78vh, 760px); padding-block: 32px;
  }

  .pp__roleicon { width: 30px; height: 30px; }
  .pp__role { display: flex; align-items: center; gap: 10px; font-size: 0.9rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--violet); }
  .pp__name-row { margin: 8px 0 16px; }
  .pp__name { font-size: clamp(2.6rem, 5.6vw, 5.6rem); line-height: .85; font-weight: 900; font-stretch: 118%; letter-spacing: -0.03em; }
  .pp__real { font-size: 0.95rem; color: var(--text-3); margin-bottom: 18px; }
  .pp__nat { display: inline-flex; align-items: center; gap: 8px; }
  .pp__quote {
    font-family: var(--font-display); font-weight: 700; font-stretch: 105%; font-size: clamp(1.3rem, 2vw, 1.6rem); line-height: 1.2;
    color: var(--text); margin: 6px 0 18px; max-width: 34ch;
  }
  .pp__champs { margin-top: 28px; }
  .pp__label { font-family: var(--font); font-stretch: 100%; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; color: var(--text-3); margin-bottom: 12px; }
  .pp__bio { max-width: 58ch; }
  .pp__socials { display: flex; gap: 8px; margin-top: 22px; }
  .pp__socials a {
    display: grid; place-items: center; width: 40px; height: 40px; border-radius: 999px;
    border: 2px solid var(--ink); color: var(--ink);
  }
  .pp__socials a:hover { background: var(--ink); color: var(--bg); }

  .pp__setup { margin-top: 30px; background: var(--surface); border-radius: var(--radius); }
  .pp__setup-head {
    display: flex; justify-content: space-between; padding: 12px 16px; border-bottom: 2px solid var(--ink);
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .pp__setup-head span:last-child { color: var(--violet); }
  .pp__setup dl div { display: flex; justify-content: space-between; gap: 16px; padding: 12px 16px; border-top: 1px solid var(--line-soft); }
  .pp__setup dl div:first-child { border-top: 0; }
  .pp__setup dt { font-size: 0.85rem; font-weight: 600; }
  .pp__setup dd { font-size: 0.85rem; color: var(--text-2); text-align: right; }

  .pp__visual {
    position: relative; align-self: stretch; display: flex; align-items: flex-end; justify-content: center;
    min-height: 420px; background: var(--violet); border-radius: var(--radius); overflow: hidden;
  }
  .pp__visual :global(.pp__bgmark) {
    position: absolute; left: 50%; top: 42%; transform: translate(-50%, -50%);
    width: 115%; height: auto; color: #fff; opacity: .1;
  }
  .pp__photo { position: relative; max-height: 100%; width: auto; object-fit: contain; }
  .pp__ghost {
    position: relative; align-self: center; writing-mode: vertical-rl; transform: rotate(180deg);
    font-family: var(--font-display); font-weight: 900; font-stretch: 125%; text-transform: uppercase;
    font-size: clamp(5rem, 12vw, 10rem); line-height: .8; color: rgba(255,255,255,.2);
  }

  .pp__rail { display: flex; flex-direction: column; gap: 8px; }
  .pp__thumb {
    display: grid; place-items: center; aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--radius);
    background: var(--surface-2); border: 2px solid transparent;
    font-size: 0.62rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3);
    opacity: .7; transition: opacity .15s ease, border-color .15s ease;
  }
  .pp__thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .pp__thumb:hover { opacity: 1; }
  .pp__thumb.is-on { opacity: 1; border-color: var(--violet); color: var(--text); }

  .pp__news { padding-block: clamp(48px, 7vw, 88px); }
  .pp__news-title { font-size: clamp(2rem, 4vw, 3rem); border-top: 2px solid var(--ink); padding-top: 16px; }
  .pp__news-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; margin-top: 24px; }

  @media (max-width: 900px) {
    .pp__grid { grid-template-columns: 1fr; min-height: 0; }
    .pp__visual { order: -1; min-height: 360px; max-height: 60vh; }
    .pp__rail { flex-direction: row; overflow-x: auto; }
    .pp__thumb { flex: 0 0 64px; }
  }
</style>
