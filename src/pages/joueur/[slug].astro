---
/* Fiche joueur (inspiration Mandatory) : identité à gauche, portrait
   détouré à droite, rail de vignettes pour passer d'un joueur à l'autre. */
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Mark from '../../components/Mark.astro';
import NewsCard from '../../components/NewsCard.astro';
import { roster, ROLE_ORDER, type Player } from '../../data/content';
import { roleLabel } from '../../data/roles';
import { site } from '../../data/site';
import { getNews } from '../../data/news';

export function getStaticPaths() {
  const ordered = [...roster].sort(
    (a, b) => ROLE_ORDER.indexOf(a.role) - ROLE_ORDER.indexOf(b.role)
  );
  return ordered.map((p, i) => ({
    params: { slug: p.slug },
    props: { player: p, ordered, index: i },
  }));
}

interface Props { player: Player; ordered: Player[]; index: number; }
const { player: p, ordered, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const socials = p.socials ?? {};
const socialList = ([
  ['tiktok', socials.tiktok], ['x', socials.x], ['instagram', socials.instagram],
  ['twitch', socials.twitch], ['youtube', socials.youtube],
] as const).filter(([, url]) => url);
const related = (await getNews()).filter((n) => n.data.players.includes(p.slug)).slice(0, 3);
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title={`${p.pseudo} · ${site.name}`} description={`${p.pseudo}, ${roleLabel[p.role]} de ${site.name}.`}>
  <article class="pp">
    <div class="container pp__frame">
      <div class="pp__top">
        <a href={`${base}/#roster`} class="pp__back"><Icon name="arrow" size={14} /> Roster</a>
        <span class="num">{pad(index + 1)} / {pad(ordered.length)}</span>
      </div>

      <div class="pp__grid">
        <div class="pp__id">
          <p class="pp__role">{roleLabel[p.role]}</p>
          <div class="pp__name-row">
            <h1 class="pp__name">{p.pseudo}</h1>
            <span class="pp__badge cut" aria-hidden="true"><Mark size={36} title="" /></span>
          </div>
          {(p.realName || p.nationality) && (
            <p class="pp__real">
              {p.realName}{p.realName && p.nationality && ' · '}{p.nationality && `${p.country} ${p.nationality}`}
            </p>
          )}
          <p class="pp__bio">{p.bio ?? `${roleLabel[p.role]} de ${site.name} pour la saison 23. Présentation complète à venir.`}</p>

          {socialList.length > 0 && (
            <div class="pp__socials">
              {socialList.map(([icon, url]) => (
                <a href={url} target="_blank" rel="noopener" aria-label={icon}><Icon name={icon} size={17} /></a>
              ))}
            </div>
          )}

          <div class="pp__setup">
            <div class="pp__setup-head"><span>Setup</span><span class="num">2026</span></div>
            {p.setup && p.setup.length > 0 ? (
              <dl>
                {p.setup.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
              </dl>
            ) : (
              <p class="pp__setup-empty">Setup bientôt disponible.</p>
            )}
          </div>
        </div>

        <div class="pp__visual">
          <Mark size={600} class="pp__bgmark" title="" />
          {p.photo ? (
            <img src={`${base}/roster/${p.photo}`} alt={`${p.pseudo}, ${roleLabel[p.role]} de ${site.name}`} class="pp__photo" />
          ) : (
            <span class="pp__ghost" aria-hidden="true">{p.pseudo}</span>
          )}
        </div>

        <nav class="pp__rail" aria-label="Autres joueurs">
          {ordered.map((o) => (
            <a href={`${base}/joueur/${o.slug}`} class:list={['pp__thumb', { 'is-on': o.slug === p.slug }]}
               aria-current={o.slug === p.slug ? 'page' : undefined} title={o.pseudo}>
              {o.photo ? <img src={`${base}/roster/${o.photo}`} alt="" /> : <span>{o.role}</span>}
            </a>
          ))}
        </nav>
      </div>

      <div class="pp__strip">
        <span>{site.name} · {site.game}</span>
        <span>Saison 23</span>
      </div>
    </div>

    {related.length > 0 && (
      <section class="container pp__news">
        <p class="kicker">Actus liées</p>
        <div class="pp__news-grid">
          {related.map((n) => <NewsCard entry={n} />)}
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .pp { background: radial-gradient(50% 60% at 72% 45%, rgba(169,35,214,.09), transparent 70%); }
  .pp__frame { padding-top: 22px; }
  .pp__top, .pp__strip {
    display: flex; justify-content: space-between; gap: 16px;
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-3);
  }
  .pp__strip { border-top: 1px solid var(--line); padding-block: 14px; }
  .pp__strip span::before, .pp__top > span::before { content: '•'; color: var(--violet); margin-right: 8px; }
  .pp__back { display: inline-flex; align-items: center; gap: 8px; }
  .pp__back :global(svg) { transform: rotate(180deg); }
  .pp__back:hover { color: var(--text); }

  .pp__grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 76px;
    gap: clamp(20px, 4vw, 48px); align-items: center;
    min-height: min(78vh, 760px); padding-block: 32px;
  }

  .pp__role { font-family: var(--font-display); font-weight: 700; font-size: 1.4rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .pp__name-row { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin: 4px 0 14px; }
  .pp__name { font-size: clamp(3.2rem, 7vw, 7rem); line-height: .82; font-weight: 800; letter-spacing: 0; min-width: 0; }
  .pp__badge {
    flex: none; display: grid; place-items: center; width: 64px; height: 64px;
    background: var(--surface-2); color: var(--text);
  }
  .pp__real { font-size: 0.9rem; color: var(--text-3); margin-bottom: 14px; }
  .pp__bio { font-size: 0.95rem; max-width: 58ch; }
  .pp__socials { display: flex; gap: 8px; margin-top: 22px; }
  .pp__socials a {
    display: grid; place-items: center; width: 38px; height: 38px;
    background: var(--surface-2); color: var(--text-2);
  }
  .pp__socials a:hover { color: var(--text); background: var(--line); }

  .pp__setup { margin-top: 30px; border: 1px solid var(--line); background: rgba(17,17,22,.7); }
  .pp__setup-head {
    display: flex; justify-content: space-between; padding: 11px 14px; background: var(--surface-2);
    font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .pp__setup-head span:last-child { color: var(--violet-bright); font-size: 0.9rem; }
  .pp__setup dl div { display: flex; justify-content: space-between; gap: 16px; padding: 12px 14px; border-top: 1px solid var(--line-soft); }
  .pp__setup dt { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
  .pp__setup dd { font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3); text-align: right; }
  .pp__setup-empty { padding: 14px; font-size: 0.85rem; color: var(--text-3); }

  .pp__visual { position: relative; align-self: stretch; display: flex; align-items: flex-end; justify-content: center; min-height: 420px; }
  .pp__visual :global(.pp__bgmark) {
    position: absolute; left: 50%; top: 45%; transform: translate(-50%, -50%);
    width: 110%; height: auto; color: var(--violet); opacity: .1;
  }
  .pp__photo {
    position: relative; max-height: 100%; width: auto; object-fit: contain;
    -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent);
            mask-image: linear-gradient(to bottom, #000 78%, transparent);
  }
  .pp__ghost {
    position: relative; align-self: center; writing-mode: vertical-rl; transform: rotate(180deg);
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    font-size: clamp(5rem, 12vw, 10rem); line-height: .8;
    color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,.14);
  }

  .pp__rail { display: flex; flex-direction: column; gap: 8px; }
  .pp__thumb {
    display: grid; place-items: center; aspect-ratio: 4 / 5; overflow: hidden;
    background: var(--surface); border: 1px solid var(--line);
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-3);
    opacity: .6; transition: opacity .15s ease, border-color .15s ease;
  }
  .pp__thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .pp__thumb:hover { opacity: 1; }
  .pp__thumb.is-on { opacity: 1; border-color: var(--violet); color: var(--text); }

  .pp__news { padding-block: clamp(48px, 7vw, 88px); }
  .pp__news-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; margin-top: 20px; }

  @media (max-width: 900px) {
    .pp__grid { grid-template-columns: 1fr; min-height: 0; }
    .pp__visual { order: -1; min-height: 360px; max-height: 60vh; }
    .pp__rail { flex-direction: row; overflow-x: auto; }
    .pp__thumb { flex: 0 0 64px; }
  }
</style>
