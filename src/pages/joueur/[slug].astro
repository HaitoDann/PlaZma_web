---
/* Fiche joueur (inspiration Mandatory) : scène plein écran, nom géant
   condensé, portrait détouré qui se fond dans le noir, rail de vignettes.
   Entrées animées + View Transitions entre deux joueurs. */
import { existsSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Mark from '../../components/Mark.astro';
import Flag from '../../components/Flag.astro';
import Champions from '../../components/Champions.astro';
import NewsCard from '../../components/NewsCard.astro';
import { roster, staff, ROLE_ORDER, type Player } from '../../data/content';
import { roleLabel } from '../../data/roles';
import { site } from '../../data/site';
import { getNews } from '../../data/news';

export function getStaticPaths() {
  const ordered = [...roster].sort(
    (a, b) => ROLE_ORDER.indexOf(a.role) - ROLE_ORDER.indexOf(b.role)
  );
  // Joueurs puis staff : même fiche, même rail.
  const people: Person[] = [
    ...ordered.map((p) => ({ ...p, label: roleLabel[p.role], short: p.role, isPlayer: true })),
    ...staff.map((s) => ({ ...s, label: s.role, short: s.role.split(' · ')[0], isPlayer: false })),
  ];
  return people.map((p, i) => ({
    params: { slug: p.slug },
    props: { player: p, ordered: people, index: i },
  }));
}

type Person = Omit<Player, 'role'> & { label: string; short: string; isPlayer: boolean };
interface Props { player: Person; ordered: Person[]; index: number; }
const { player: p, ordered, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const socials = p.socials ?? {};
const socialList = ([
  ['tiktok', socials.tiktok], ['x', socials.x], ['instagram', socials.instagram],
  ['twitch', socials.twitch], ['youtube', socials.youtube],
] as const).filter(([, url]) => url);
const related = (await getNews()).filter((n) => n.data.players.includes(p.slug)).slice(0, 3);
// Icône de poste : public/img/roles/<poste>.webp (ex. mid.webp)
const roleIcon = (r: string) => existsSync(`public/img/roles/${r.toLowerCase()}.webp`) ? `${base}/img/roles/${r.toLowerCase()}.webp` : '';
const pad = (n: number) => String(n).padStart(2, '0');
const prev = ordered[(index - 1 + ordered.length) % ordered.length];
const next = ordered[(index + 1) % ordered.length];
---
<Base title={`${p.pseudo} · ${site.name}`} description={`${p.pseudo}, ${p.label} de ${site.name}.`}>
  <article class="pp">
    <div class="container pp__frame">
      <div class="pp__top">
        <a href={`${base}/#roster`} class="pp__back"><Icon name="arrow" size={14} /> Roster</a>
        <span class="pp__nav">
          <a href={`${base}/joueur/${prev.slug}`} aria-label={`Précédent : ${prev.pseudo}`} class="pp__arrow pp__arrow--prev"><Icon name="arrow" size={14} /></a>
          <span class="num">{pad(index + 1)} / {pad(ordered.length)}</span>
          <a href={`${base}/joueur/${next.slug}`} aria-label={`Suivant : ${next.pseudo}`} class="pp__arrow"><Icon name="arrow" size={14} /></a>
        </span>
      </div>

      <div class="pp__grid">
        <div class="pp__id">
          <p class="pp__role">
            {p.isPlayer && roleIcon(p.short) && <img src={roleIcon(p.short)} alt="" width="34" height="34" class="pp__roleicon" />}
            {p.label}{p.captain && <span class="pp__role-cap"> · Capitaine</span>}
          </p>
          <div class="pp__name-row">
            <h1 class="pp__name" transition:name="pp-name"><span>{p.pseudo}</span></h1>
          </div>
          {(p.realName || p.age || p.nationality) && (
            <p class="pp__real">
              {p.realName}{p.realName && (p.age || p.nationality) && ' · '}{p.age && `${p.age} ans`}{p.age && p.nationality && ' · '}{p.nationality && <span class="pp__nat">{p.country && <Flag emoji={p.country} />} {p.nationality}</span>}
            </p>
          )}
          {p.quote && <blockquote class="pp__quote">« {p.quote} »</blockquote>}
          {p.bio && <p class="pp__bio">{p.bio}</p>}
          {p.champions && p.champions.length > 0 && (
            <div class="pp__champs">
              <h2 class="pp__label">Champions favoris</h2>
              <Champions names={p.champions} />
            </div>
          )}

          {socialList.length > 0 && (
            <div class="pp__socials">
              {socialList.map(([icon, url]) => (
                <a href={url} target="_blank" rel="noopener" aria-label={icon}><Icon name={icon} size={17} /></a>
              ))}
            </div>
          )}

          {p.isPlayer && p.setup && p.setup.length > 0 && <div class="pp__setup">
            <div class="pp__setup-head"><span>Setup</span><span class="num">2026</span></div>
            <dl>
                {p.setup.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
              </dl>
          </div>}
        </div>

        <div class="pp__visual" transition:name="pp-visual">
          <Mark size={600} class="pp__bgmark" title="" />
          {p.photo ? (
            <img src={`${base}/roster/${p.photo}`} alt={`${p.pseudo}, ${p.label} de ${site.name}`} class="pp__photo" />
          ) : (
            <span class="pp__ghost" aria-hidden="true">{p.pseudo}</span>
          )}
        </div>

        <nav class="pp__rail" aria-label="Autres joueurs">
          {ordered.map((o) => (
            <a href={`${base}/joueur/${o.slug}`} class:list={['pp__thumb', { 'is-on': o.slug === p.slug }]}
               aria-current={o.slug === p.slug ? 'page' : undefined} title={o.pseudo}>
              {o.photo ? <img src={`${base}/roster/${o.photo}`} alt="" /> : <span>{o.short}</span>}
              <em class="pp__tip">{o.pseudo}</em>
            </a>
          ))}
        </nav>
      </div>

    </div>

    {related.length > 0 && (
      <section class="container pp__news">
        <h2 class="pp__news-title">Actus</h2>
        <div class="pp__news-grid">
          {related.map((n) => <NewsCard entry={n} />)}
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .pp { position: relative; overflow: hidden; }
  .pp::before {   /* halo prune derrière le portrait */
    content: ''; position: absolute; right: -10%; top: 0; width: 70%; height: 100%; pointer-events: none;
    background: radial-gradient(closest-side, rgba(169, 35, 214, .14), transparent 75%);
  }
  .pp__frame { position: relative; padding-top: 18px; }
  .pp__top {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    border-bottom: 1px solid var(--line); padding-bottom: 12px;
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-2);
  }
  .pp__back { display: inline-flex; align-items: center; gap: 8px; }
  .pp__back::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--violet-bright); }
  .pp__back :global(svg) { display: none; }
  .pp__back:hover { color: var(--text); }
  .pp__nav { display: flex; align-items: center; gap: 12px; }
  .pp__arrow {
    display: grid; place-items: center; width: 30px; height: 30px; border-radius: 999px; border: 1px solid var(--line);
    transition: border-color .2s ease, color .2s ease;
  }
  .pp__arrow:hover { border-color: var(--violet); color: var(--violet-ink); }
  .pp__arrow--prev :global(svg) { transform: rotate(180deg); }

  .pp__grid {
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr) 72px;
    gap: clamp(20px, 3vw, 40px); align-items: center;
    min-height: calc(100vh - var(--nav-h) - 60px); padding-block: 24px 0;
  }

  /* Entrées animées (rejouées à chaque joueur) */
  .pp__id > * { animation: pp-up .9s var(--ease) both; }
  .pp__id > :nth-child(2) { animation-delay: .06s; }
  .pp__id > :nth-child(3) { animation-delay: .12s; }
  .pp__id > :nth-child(4) { animation-delay: .18s; }
  .pp__id > :nth-child(5) { animation-delay: .24s; }
  .pp__id > :nth-child(n+6) { animation-delay: .3s; }
  .pp__name span { display: inline-block; animation: pp-name 1s var(--ease) both; }
  .pp__name { overflow: hidden; padding-top: .14em; margin-top: -.14em; padding-bottom: .04em; }
  .pp__photo, .pp__ghost { animation: pp-photo 1.1s var(--ease) both; }
  @keyframes pp-up { from { opacity: 0; transform: translateY(18px); } }
  @keyframes pp-name { from { transform: translateY(105%); } }
  @keyframes pp-photo { from { opacity: 0; transform: translateX(40px) scale(.98); } }
  @media (prefers-reduced-motion: reduce) { .pp__id > *, .pp__name span, .pp__photo, .pp__ghost { animation: none; } }

  .pp__roleicon { width: 26px; height: 26px; }
  .pp__role { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 800; font-stretch: 118%; font-size: 1.15rem; text-transform: uppercase; color: var(--text); }
  .pp__role-cap { color: var(--violet); }
  .pp__name-row { margin: 10px 0 18px; }
  .pp__name {
    font-size: clamp(4rem, 10vw, 9rem); line-height: .82; font-weight: 900; font-stretch: 62%;
    letter-spacing: -0.01em;
  }
  .pp__real { font-size: 0.9rem; color: var(--text-3); margin-bottom: 18px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .pp__nat { display: inline-flex; align-items: center; gap: 8px; }
  .pp__quote {
    font-family: var(--font-display); font-weight: 700; font-stretch: 100%; font-size: clamp(1.2rem, 1.8vw, 1.45rem); line-height: 1.25;
    color: var(--violet-ink); margin: 6px 0 16px; max-width: 38ch;
  }
  .pp__bio { max-width: 60ch; }
  .pp__champs { margin-top: 26px; }
  .pp__label { font-family: var(--font); font-stretch: 100%; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; color: var(--text-3); margin-bottom: 12px; }
  .pp__socials { display: flex; gap: 8px; margin-top: 22px; }
  .pp__socials a {
    display: grid; place-items: center; width: 38px; height: 38px; border-radius: 999px;
    border: 1px solid var(--line); color: var(--text-2); transition: border-color .2s ease, color .2s ease;
  }
  .pp__socials a:hover { border-color: var(--violet); color: var(--text); }

  /* Tableau de setup (façon Mandatory) */
  .pp__setup { margin-top: 26px; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: rgba(21,19,26,.7); }
  .pp__setup-head {
    display: flex; justify-content: space-between; padding: 11px 16px; background: var(--surface-2);
    font-family: var(--font-display); font-weight: 800; font-stretch: 118%; font-size: 0.95rem; text-transform: uppercase;
  }
  .pp__setup-head span:last-child { color: var(--violet); }
  .pp__setup dl div { display: flex; justify-content: space-between; gap: 16px; padding: 11px 16px; border-top: 1px solid var(--line-soft); }
  .pp__setup dt { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
  .pp__setup dd { font-size: 0.8rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-3); text-align: right; }

  .pp__visual {
    position: relative; align-self: stretch; display: flex; align-items: flex-end; justify-content: center;
    min-height: 460px;
  }
  .pp__visual :global(.pp__bgmark) {
    position: absolute; left: 50%; top: 40%; transform: translate(-50%, -50%);
    width: 120%; height: auto; color: var(--violet); opacity: .05;
  }
  .pp__photo {
    position: relative; max-height: calc(100vh - var(--nav-h) - 100px); width: auto; object-fit: contain;
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent 98%);
            mask-image: linear-gradient(to bottom, #000 72%, transparent 98%);
  }
  .pp__ghost {
    position: relative; align-self: center; writing-mode: vertical-rl; transform: rotate(180deg);
    font-family: var(--font-display); font-weight: 900; font-stretch: 62%; text-transform: uppercase;
    font-size: clamp(6rem, 14vw, 13rem); line-height: .8; color: transparent; -webkit-text-stroke: 1px var(--line);
  }

  /* Rail de vignettes */
  .pp__rail { display: flex; flex-direction: column; gap: 8px; }
  .pp__thumb {
    position: relative; display: grid; place-items: center; aspect-ratio: 4 / 5; overflow: visible;
    background: var(--surface); border: 1px solid var(--line); border-radius: 4px;
    font-size: 0.58rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3);
    transition: border-color .25s ease, transform .4s var(--ease);
  }
  .pp__thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 3px; filter: grayscale(1) brightness(.7); transition: filter .3s ease; }
  .pp__thumb:hover { transform: translateX(-4px); }
  .pp__thumb:hover img, .pp__thumb.is-on img { filter: none; }
  .pp__thumb.is-on { border-color: var(--violet); color: var(--text); }
  .pp__tip {
    position: absolute; right: calc(100% + 10px); top: 50%; transform: translate(6px, -50%); white-space: nowrap;
    font-style: normal; font-size: 0.75rem; letter-spacing: 0.04em; color: var(--text); background: var(--surface-2);
    padding: 5px 9px; border-radius: 4px; opacity: 0; pointer-events: none; transition: opacity .2s ease, transform .3s var(--ease);
  }
  .pp__thumb:hover .pp__tip { opacity: 1; transform: translate(0, -50%); }

  .pp__news { position: relative; padding-block: clamp(48px, 7vw, 88px); }
  .pp__news-title { font-size: clamp(2rem, 4vw, 3rem); border-top: 1px solid var(--line); padding-top: 16px; }
  .pp__news-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 10px; margin-top: 24px; }

  @media (max-width: 900px) {
    .pp__grid { grid-template-columns: 1fr; min-height: 0; }
    .pp__visual { order: -1; min-height: 340px; max-height: 58vh; }
    .pp__photo { max-height: 58vh; }
    .pp__rail { flex-direction: row; overflow-x: auto; }
    .pp__thumb { flex: 0 0 60px; }
    .pp__tip { display: none; }
  }
</style>
