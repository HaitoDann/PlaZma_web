---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { roster, ROLE_ORDER, type Player } from '../../data/content';
import { roleLabel } from '../../data/roles';
import { site } from '../../data/site';

export function getStaticPaths() {
  const ordered = [...roster].sort(
    (a, b) => ROLE_ORDER.indexOf(a.role) - ROLE_ORDER.indexOf(b.role)
  );
  return ordered.map((p, i) => ({
    params: { slug: p.slug },
    props: {
      player: p,
      prev: ordered[(i - 1 + ordered.length) % ordered.length],
      next: ordered[(i + 1) % ordered.length],
    },
  }));
}

interface Props { player: Player; prev: Player; next: Player; }
const { player: p, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const socials = p.socials ?? {};
const socialList = ([
  ['twitch', socials.twitch], ['x', socials.x], ['instagram', socials.instagram],
  ['youtube', socials.youtube], ['tiktok', socials.tiktok],
] as const).filter(([, url]) => url);
const hasPhoto = Boolean(p.photo);
---
<Base title={`${p.pseudo} · ${site.name}`} description={`${p.pseudo}, ${roleLabel[p.role]} de ${site.name}.`}>
  <article class="pp">
    <div class="container">
      <a href={`${base}/#roster`} class="pp__back"><Icon name="arrow" size={15} /> Retour au roster</a>

      <div class={`pp__head ${hasPhoto ? 'has-photo' : ''}`}>
        <div class="pp__id">
          <p class="overline">{roleLabel[p.role]}</p>
          <h1 class="pp__name">{p.pseudo}</h1>
          <p class="pp__real">
            {p.realName && <span>{p.realName}</span>}
            {p.nationality && <span class="pp__nat">{p.country} {p.nationality}</span>}
          </p>

          <p class="pp__bio">{p.bio ?? `Joueur ${roleLabel[p.role]} de ${site.name}. Présentation à venir.`}</p>

          {socialList.length > 0 && (
            <div class="pp__socials">
              {socialList.map(([icon, url]) => (
                <a href={url} target="_blank" rel="noopener" aria-label={icon}><Icon name={icon} size={19} /></a>
              ))}
            </div>
          )}
        </div>

        {hasPhoto && (
          <div class="pp__photo">
            <img src={`${base}/roster/${p.photo}`} alt={`${p.pseudo}, ${roleLabel[p.role]} de ${site.name}`} />
          </div>
        )}
      </div>

      {p.setup && p.setup.length > 0 && (
        <section class="pp__setup">
          <p class="overline">Setup</p>
          <dl class="pp__setup-list">
            {p.setup.map((s) => (
              <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
            ))}
          </dl>
        </section>
      )}

      <nav class="pp__nav" aria-label="Autres joueurs">
        <a href={`${base}/joueur/${prev.slug}`} class="pp__navlink pp__navlink--prev">
          <Icon name="arrow" size={15} />
          <span><em>Précédent</em>{prev.pseudo}</span>
        </a>
        <a href={`${base}/joueur/${next.slug}`} class="pp__navlink pp__navlink--next">
          <span><em>Suivant</em>{next.pseudo}</span>
          <Icon name="arrow" size={15} />
        </a>
      </nav>
    </div>
  </article>
</Base>

<style>
  .pp { padding-block: clamp(28px, 4vw, 44px) clamp(48px, 7vw, 80px); }
  .pp__back { display: inline-flex; align-items: center; gap: 8px; color: var(--text-3); font-size: 0.9rem; margin-bottom: clamp(32px, 5vw, 56px); }
  .pp__back :global(svg) { transform: rotate(180deg); }
  .pp__back:hover { color: var(--text); }

  .pp__head { max-width: 680px; }
  .pp__head.has-photo {
    max-width: none; display: grid; grid-template-columns: 1fr 0.8fr;
    gap: clamp(28px, 5vw, 64px); align-items: center;
  }
  .pp__name { font-size: clamp(3rem, 8vw, 6rem); margin: 12px 0 16px; line-height: 0.95; }
  .pp__real { display: flex; gap: 16px; flex-wrap: wrap; color: var(--text-2); font-size: 1.05rem; margin-bottom: 26px; }
  .pp__nat { color: var(--text-3); }
  .pp__bio { color: var(--text-2); max-width: 54ch; font-size: 1.05rem; }

  .pp__socials { display: flex; gap: 10px; margin-top: 28px; }
  .pp__socials a {
    width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid var(--line); color: var(--text-2); border-radius: var(--r);
    transition: color .15s ease, border-color .15s ease;
  }
  .pp__socials a:hover { color: var(--text); border-color: var(--text-3); }

  .pp__photo { align-self: stretch; }
  .pp__photo img { width: 100%; height: 100%; object-fit: cover; border-radius: var(--r-lg); }

  .pp__setup { margin-top: clamp(40px, 6vw, 64px); max-width: 560px; }
  .pp__setup .overline { margin-bottom: 16px; }
  .pp__setup-list > div { display: flex; justify-content: space-between; gap: 16px; padding: 13px 0; border-bottom: 1px solid var(--line); }
  .pp__setup-list dt { color: var(--text-3); font-size: 0.9rem; }
  .pp__setup-list dd { font-weight: 600; }

  .pp__nav { display: flex; justify-content: space-between; gap: 16px; margin-top: clamp(48px, 7vw, 80px); padding-top: 26px; border-top: 1px solid var(--line); }
  .pp__navlink { display: inline-flex; align-items: center; gap: 12px; color: var(--text-2); }
  .pp__navlink:hover { color: var(--text); }
  .pp__navlink span { display: flex; flex-direction: column; font-family: var(--font-display); font-weight: 800; }
  .pp__navlink--next span { text-align: right; }
  .pp__navlink em { font-weight: 500; font-style: normal; font-size: 0.72rem; color: var(--text-3); font-family: var(--font); }
  .pp__navlink--prev :global(svg) { transform: rotate(180deg); }

  @media (max-width: 760px) {
    .pp__head.has-photo { grid-template-columns: 1fr; }
    .pp__photo { order: -1; aspect-ratio: 4 / 3; }
  }
</style>
