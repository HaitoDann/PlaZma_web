---
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import Icon from '../../components/Icon.astro';
import { roster, ROLE_ORDER, type Player } from '../../data/content';
import { roleColor, roleLabel } from '../../data/roles';
import { site } from '../../data/site';

export function getStaticPaths() {
  const ordered = [...roster].sort(
    (a, b) => ROLE_ORDER.indexOf(a.role) - ROLE_ORDER.indexOf(b.role)
  );
  return ordered.map((p, i) => {
    const prev = ordered[(i - 1 + ordered.length) % ordered.length];
    const next = ordered[(i + 1) % ordered.length];
    return { params: { slug: p.slug }, props: { player: p, index: i, prev, next } };
  });
}

interface Props { player: Player; index: number; prev: Player; next: Player; }
const { player: p, index, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const color = roleColor[p.role];
const socials = p.socials ?? {};
const socialList = ([
  ['twitch', socials.twitch], ['x', socials.x],
  ['instagram', socials.instagram], ['youtube', socials.youtube], ['tiktok', socials.tiktok],
] as const).filter(([, url]) => url);
---
<Base title={`${p.pseudo} · ${site.name}`} description={`${p.pseudo} — ${roleLabel[p.role]} de ${site.name}.`}>
  <article class="pp" style={`--role:${color}`}>
    <!-- Barre HUD supérieure -->
    <div class="container pp__hud">
      <a href={`${base}/#roster`} class="pp__back"><Icon name="arrow" size={15} /> Roster</a>
      <span class="pp__hud-mid">● {roleLabel[p.role]}</span>
      <span class="pp__hud-right num">PLZ-{String(index + 1).padStart(2, '0')} · ©26</span>
    </div>

    <div class="container pp__grid">
      <!-- Colonne gauche : identité + infos -->
      <div class="pp__left">
        <p class="pp__role">{p.role} / {p.nationality ?? ''}</p>
        <h1 class="pp__name">{p.pseudo}</h1>

        {p.realName && <p class="pp__real">{p.country} {p.realName}</p>}

        <p class="pp__bio">
          {p.bio ?? `Joueur ${roleLabel[p.role]} de ${site.name}. Biographie à venir.`}
        </p>

        {socialList.length > 0 && (
          <div class="pp__socials">
            {socialList.map(([icon, url]) => (
              <a href={url} target="_blank" rel="noopener" aria-label={icon} class="pp__social">
                <Icon name={icon} size={18} />
              </a>
            ))}
          </div>
        )}

        <!-- Setup -->
        <div class="pp__setup">
          <div class="pp__setup-head">
            <span>Setup</span><span class="num">26</span>
          </div>
          {p.setup && p.setup.length > 0
            ? p.setup.map((s) => (
                <div class="pp__setup-row">
                  <span class="pp__setup-label">{s.label}</span>
                  <span class="pp__setup-val">{s.value}</span>
                </div>
              ))
            : <div class="pp__setup-row pp__setup-row--empty"><span>Matériel à renseigner</span></div>}
        </div>
      </div>

      <!-- Colonne droite : visuel -->
      <div class="pp__media">
        <span class="pp__streaks" aria-hidden="true"></span>
        <span class="pp__watermark num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        {p.photo
          ? <img src={`${base}/roster/${p.photo}`} alt={p.pseudo} class="pp__photo" />
          : <span class="pp__fallback" aria-hidden="true"><Mark size="52%" /></span>}
        <span class="pp__coords num" aria-hidden="true">{site.name.toUpperCase()} · {p.slug.toUpperCase()}</span>
      </div>
    </div>

    <!-- Navigation prev / next -->
    <div class="container pp__nav">
      <a href={`${base}/joueur/${prev.slug}`} class="pp__navlink pp__navlink--prev">
        <Icon name="arrow" size={15} />
        <span><em>Précédent</em>{prev.pseudo}</span>
      </a>
      <a href={`${base}/joueur/${next.slug}`} class="pp__navlink pp__navlink--next">
        <span><em>Suivant</em>{next.pseudo}</span>
        <Icon name="arrow" size={15} />
      </a>
    </div>
  </article>
</Base>

<style>
  .pp { padding-block: 18px clamp(40px, 7vw, 80px); }

  .pp__hud {
    display: flex; align-items: center; gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--text-3);
  }
  .pp__back { display: inline-flex; align-items: center; gap: 7px; color: var(--text-2); }
  .pp__back:hover { color: var(--violet-soft); }
  .pp__back :global(svg) { transform: rotate(180deg); }
  .pp__hud-mid { color: var(--role); margin-left: 6px; }
  .pp__hud-right { margin-left: auto; }

  .pp__grid {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    padding-block: clamp(32px, 6vw, 72px);
  }
  .pp__role {
    font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--violet-soft); margin-bottom: 14px;
  }
  .pp__name {
    font-size: clamp(3.4rem, 10vw, 8rem);
    line-height: 0.85; letter-spacing: -0.03em;
    margin-bottom: 18px;
  }
  .pp__real { font-size: 1.05rem; color: var(--text-2); margin-bottom: 22px; }
  .pp__bio { max-width: 52ch; color: var(--text-2); margin-bottom: 24px; }

  .pp__socials { display: flex; gap: 8px; margin-bottom: 30px; }
  .pp__social {
    width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center;
    background: var(--surface); border: 1px solid var(--line); color: var(--text-2);
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }
  .pp__social:hover { color: #fff; background: var(--violet); border-color: var(--violet); }

  .pp__setup { border-top: 1px solid var(--line-strong); max-width: 480px; }
  .pp__setup-head {
    display: flex; justify-content: space-between;
    font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--violet); padding: 12px 2px;
    border-bottom: 1px solid var(--line);
  }
  .pp__setup-row {
    display: flex; justify-content: space-between; gap: 16px;
    padding: 12px 2px; border-bottom: 1px solid var(--line);
    font-size: 0.9rem;
  }
  .pp__setup-label { color: var(--text-3); font-family: var(--font-mono); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .pp__setup-val { font-weight: 600; text-align: right; }
  .pp__setup-row--empty { color: var(--text-3); font-style: italic; justify-content: flex-start; }

  /* Visuel */
  .pp__media {
    position: relative;
    aspect-ratio: 4 / 5;
    background:
      radial-gradient(120% 90% at 60% 10%, color-mix(in srgb, var(--role) 22%, transparent), transparent 60%),
      linear-gradient(180deg, var(--surface-2), #0a0a10);
    border: 1px solid var(--line);
    border-top: 2px solid var(--role);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .pp__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pp__fallback { color: var(--role); opacity: 0.22; display: flex; }
  .pp__streaks {
    position: absolute; inset: 0; pointer-events: none;
    background-image: repeating-linear-gradient(118deg,
      color-mix(in srgb, var(--role) 80%, transparent) 0 2px, transparent 2px 18px);
    opacity: 0.14;
    -webkit-mask: radial-gradient(120% 120% at 100% 0, #000, transparent 58%);
    mask: radial-gradient(120% 120% at 100% 0, #000, transparent 58%);
  }
  .pp__watermark {
    position: absolute; right: -4px; bottom: -34px;
    font-size: 14rem; font-weight: 700; line-height: 1;
    color: #fff; opacity: 0.04; pointer-events: none;
  }
  .pp__coords {
    position: absolute; left: 12px; bottom: 12px;
    font-size: 0.66rem; letter-spacing: 0.1em; color: var(--text-3);
  }
  .pp__coords::before { content: '● '; color: var(--role); }

  /* Nav prev/next */
  .pp__nav {
    display: flex; justify-content: space-between; gap: 16px;
    border-top: 1px solid var(--line); padding-top: 24px;
  }
  .pp__navlink { display: inline-flex; align-items: center; gap: 12px; color: var(--text-2); }
  .pp__navlink:hover { color: #fff; }
  .pp__navlink span { display: flex; flex-direction: column; font-family: var(--font-display); font-weight: 800; text-transform: uppercase; }
  .pp__navlink--next span { text-align: right; }
  .pp__navlink em {
    font-family: var(--font-mono); font-weight: 500; font-style: normal;
    font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3);
  }
  .pp__navlink--prev :global(svg) { transform: rotate(180deg); }

  @media (max-width: 820px) {
    .pp__grid { grid-template-columns: 1fr; }
    .pp__media { order: -1; aspect-ratio: 16 / 11; }
    .pp__watermark { font-size: 9rem; bottom: -20px; }
  }
</style>
